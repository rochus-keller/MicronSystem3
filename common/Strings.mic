  ISOToOberon[255] := "y"
  CRLF[0] := CR
  CRLF[1] := LF
  CRLF[2] := 0X
  CRLF[3] := 0X
end Init

begin
  Modules.Register("Strings", nil)
  Init()
end Strings.
