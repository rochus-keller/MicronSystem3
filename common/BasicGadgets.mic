module BasicGadgets [level=5]

import Objects, Gadgets, Display, Display3, Effects, Oberon, Texts, Files, Printer, Printer3, Fonts, Strings, Modules
// portable
// jm 18.1.95

(** Contains an implementation of the model gadgets Boolean, String, Integer, and Real, and of the visual gadgets Button, Checkbox and Slider. The buttons and checkboxes can also be used as radio-buttons by linking to them an Integer model gadget.
*)
(*
JM 3.2.93 - New radio button look
- SetValues improved
- Gadgets.UpdateMsg goes to abstract gadgets too
JM 8.2.93 - Cancel combination for button clicks improved
jm 9.2.93 - new abstract object rooted in gadgets
- Respond on Viewers.ViewerMsg
jm 11.2.93 - Display.ControlMsg
jm 3.2.93 - popout buttons improved
23.7.93 - simplified copy of abstract objects
19.4.94 - popout attribute is now set by default for buttons
19.4.94 - Added Break
21.4.95 - fixed command execution of checkboxes
27.9.95 - fixed slider update model
13.10.95 - Changed popout behavior of buttons
3.5.96 - YesVal of checkboxes now always returns a value (ps - 3.5.96)
8.5.96 - Add Look-Link to Buttons (ps - 8.5.96)
29.7.96 - fixed NIL-trap in SetValues (ps - 29.7.96)
20.11.96 - add 2 new button attributes (iw)
25.4.97 - fixed bug in ButtonAttr (YesVal)
*)

const
  VersionNo = 2
  VersionNewButton = 4
  VersionAbstract = 4
  VersionNewCheckbox = 3

  MaxLen = 64

// --- Things ---

type
  Boolean* = pointer to BooleanDesc
  BooleanDesc* = object (Gadgets.ObjDesc)
    val_*: boolean
  end

  String* = pointer to StringDesc
  StringDesc* = object (Gadgets.ObjDesc)
    val_*: array 64 (* MaxLen *) of char
  end

  Integer* = pointer to IntegerDesc
  IntegerDesc* = object (Gadgets.ObjDesc)
    val_*: int32
  end

  Real* = pointer to RealDesc
  RealDesc* = object (Gadgets.ObjDesc)
    val_*: longreal
  end

  // --- Gadgets ---

  Button* = pointer to ButtonDesc
  ButtonDesc* = object (Gadgets.FrameDesc)
    caption*: array 32 of char // Caption shown inside the button.
    val_*: boolean // Pushed/popped out.
    popout*: boolean // Button should pop out immediately after pressed.
    setval*: int16 // Button is pressed should the button model have this value.
    look*: Objects.Object // Object dropped inside of button, used as button representation instead of caption.
    led*: boolean // visibility of a led if Button is pressed
    ledcol*: int16 // Color of LED when Button is pressed
    inM, outM: Display3.Mask
  end

  CheckBox* = pointer to CheckBoxDesc
  CheckBoxDesc* = object (Gadgets.FrameDesc)
    val_*: boolean // State.
    setval*: int16 // checkbox is ticked should the checkbox model have this value.
  end

  Slider* = pointer to SliderDesc
  SliderDesc* = object (Gadgets.FrameDesc)
    min_*: int32 // Minimum, maximum and current value
    max_*, val_*: int32
    B, BW: int16
  end

var
  W: Texts.Writer

procedure Log()
begin
  Texts.Append(Oberon.Log, W.buf)
end Log

procedure Min(x, y: int16): int16
begin
  if x < y then
    return x
  else
    return y
  end
  return 0 // TODO o2m: Micron requires a result on all control paths
end Min

procedure KillMasks(F: Objects.Object)
  var
    O: Display3.OverlapMsg
begin
  O.F := nil
  O.M := nil
  O.x := 0
  O.y := 0
  O.res := -1
  O.dlink := nil
  F.handle(F, @O)
end KillMasks

// --- Version check ---

procedure WriteVersion(R: pointer to Files.Rider)
begin
  Files.WriteNum(R, VersionNo)
end WriteVersion

procedure ReadVersion(R: pointer to Files.Rider)
  var
    x: int32
begin
  Files.ReadNum(R, @x)
  if x # VersionNo then
    Texts.WriteString(@W, "Version ")
    Texts.WriteInt(@W, VersionNo, 3)
    Texts.WriteString(@W, " of BasicGadgets cannot read version ")
    Texts.WriteInt(@W, x, 3)
    Texts.WriteLn(@W)
    Log()
    halt(42)
  end
end ReadVersion

// ---------- abstract objects ----------

procedure CopyBoolean*(M: pointer to Objects.CopyMsg; from, to_: Boolean)
begin
  Gadgets.CopyObject(M, from, to_)
  to_.val_ := from.val_
end CopyBoolean

procedure BooleanHandler*(obj: Objects.Object; M: pointer to Objects.ObjMsg)
  var
    obj2: Boolean
    x: int16
    ver: int32
begin
  case obj of
  | Boolean:
    case M of
    | Objects.PAttrMsg:
      if M.id = Objects.get then
        if M.name = "Gen" then
          copy(@M.s, "BasicGadgets.NewBoolean", 64)
          M.class := Objects.String
          M.res := 0
        elsif M.name = "Value" then
          M.b := obj.val_
          M.class := Objects.Bool
          M.res := 0
        else
          Gadgets.objecthandle(obj, M)
        end

      elsif M.id = Objects.set_ then
        if M.name = "Value" then
          if M.class = Objects.Bool then
            obj.val_ := M.b
            M.res := 0
          end
        else
          Gadgets.objecthandle(obj, M)
        end

      elsif M.id = Objects.enum then
        M.Enum("Value")
        Gadgets.objecthandle(obj, M)
      end

    | Objects.PFileMsg:
      if M.id = Objects.store then
        Files.WriteNum(@M.R, VersionAbstract)
        Files.WriteBool(@M.R, obj.val_)
        Gadgets.objecthandle(obj, M)
      // WriteVersion(M.R); IF obj.val THEN Files.WriteInt(M.R, 1); ELSE Files.WriteInt(M.R, 0); END;
      elsif M.id = Objects.load then
        Files.ReadNum(@M.R, @ver)
        if ver = VersionNo then
          // old
          Files.ReadInt(@M.R, @x)
          obj.val_ := x = 1
        elsif ver = VersionAbstract then
          Files.ReadBool(@M.R, @obj.val_)
          Gadgets.objecthandle(obj, M)
        else
          Texts.WriteString(@W, "Version ")
          Texts.WriteInt(@W, VersionAbstract, 3)
          Texts.WriteString(@W, " of boolean cannot read version ")
          Texts.WriteInt(@W, ver, 3)
          Texts.WriteLn(@W)
          Log()
          halt(42)
        end
      end

    | Objects.PCopyMsg:
      if M.stamp = obj.stamp then
        M.obj := obj.dlink
      else
        newgc(obj2)
        obj.stamp := M.stamp
        obj.dlink := obj2
        CopyBoolean(M, obj, obj2)
        M.obj := obj2
      end

    else
      Gadgets.objecthandle(obj, M)
    end
  end
end BooleanHandler

procedure InitBoolean*(obj: Boolean)
begin
  obj.handle := BooleanHandler
end InitBoolean

procedure NewBoolean*()
  var
    obj: Boolean
begin
  newgc(obj)
  InitBoolean(obj)
  Objects.NewObj := obj
end NewBoolean

procedure CopyString*(M: pointer to Objects.CopyMsg; from, to_: String)
begin
  Gadgets.CopyObject(M, from, to_)
  copy(@to_.val_, @from.val_, 64 (* MaxLen *))
end CopyString

procedure StringHandler*(obj: Objects.Object; M: pointer to Objects.ObjMsg)
  var
    obj2: String
    ver: int32
begin
  case obj of
  | String:
    case M of
    | Objects.PAttrMsg:
      if M.id = Objects.get then
        if M.name = "Gen" then
          copy(@M.s, "BasicGadgets.NewString", 64)
          M.class := Objects.String
          M.res := 0
        elsif M.name = "Value" then
          copy(@M.s, @obj.val_, 64)
          M.class := Objects.String
          M.res := 0
        else
          Gadgets.objecthandle(obj, M)
        end

      elsif M.id = Objects.set_ then
        if M.name = "Value" then
          if M.class = Objects.String then
            copy(@obj.val_, @M.s, 64 (* MaxLen *))
            M.res := 0
          elsif M.class = Objects.Int then
            Strings.IntToStr(M.i, @obj.val_, 64 (* MaxLen *))
            M.res := 0
          elsif M.class = Objects.Real then
            Strings.RealToStr(val(longreal, M.x), @obj.val_, 64 (* MaxLen *))
            M.res := 0
          elsif M.class = Objects.LongReal then
            Strings.RealToStr(M.y, @obj.val_, 64 (* MaxLen *))
            M.res := 0
          end

        else
          Gadgets.objecthandle(obj, M)
        end

      elsif M.id = Objects.enum then
        M.Enum("Value")
        Gadgets.objecthandle(obj, M)
      end

    | Objects.PFileMsg:
      if M.id = Objects.store then
        Files.WriteNum(@M.R, VersionAbstract)
        Files.WriteString(@M.R, @obj.val_, 64 (* MaxLen *))
        Gadgets.objecthandle(obj, M)
      elsif M.id = Objects.load then
        Files.ReadNum(@M.R, @ver)
        if ver = VersionNo then
          // old
          Files.ReadString(@M.R, @obj.val_, 64 (* MaxLen *))
        elsif ver = VersionAbstract then
          Files.ReadString(@M.R, @obj.val_, 64 (* MaxLen *))
          Gadgets.objecthandle(obj, M)
        else
          Texts.WriteString(@W, "Version ")
          Texts.WriteInt(@W, VersionAbstract, 3)
          Texts.WriteString(@W, " of string cannot read version ")
          Texts.WriteInt(@W, ver, 3)
          Texts.WriteLn(@W)
          Log()
          halt(42)
        end
      end

    | Objects.PCopyMsg:
      if M.stamp = obj.stamp then
        M.obj := obj.dlink
      else
        newgc(obj2)
        obj.stamp := M.stamp
        obj.dlink := obj2
        CopyString(M, obj, obj2)
        M.obj := obj2
      end

    else
      Gadgets.objecthandle(obj, M)
    end
  end
end StringHandler

procedure InitString*(obj: String)
begin
  obj.handle := StringHandler
  copy(@obj.val_, "", 64 (* MaxLen *))
end InitString

procedure NewString*()
  var
    obj: String
begin
  newgc(obj)
  InitString(obj)
  Objects.NewObj := obj
end NewString

procedure CopyInteger*(M: pointer to Objects.CopyMsg; from, to_: Integer)
begin
  Gadgets.CopyObject(M, from, to_)
  to_.val_ := from.val_
end CopyInteger

procedure IntegerHandler*(obj: Objects.Object; M: pointer to Objects.ObjMsg)
  var
    obj2: Integer
    ver: int32
begin
  case obj of
  | Integer:
    case M of
    | Objects.PAttrMsg:
      if M.id = Objects.get then
        if M.name = "Gen" then
          copy(@M.s, "BasicGadgets.NewInteger", 64)
          M.class := Objects.String
          M.res := 0
        elsif M.name = "Value" then
          M.i := obj.val_
          M.class := Objects.Int
          M.res := 0
        else
          Gadgets.objecthandle(obj, M)
        end

      elsif M.id = Objects.set_ then
        if M.name = "Value" then
          if M.class = Objects.Int then
            obj.val_ := M.i
            M.res := 0
          elsif M.class = Objects.String then
            Strings.StrToInt(@M.s, @obj.val_)
            M.res := 0
          elsif M.class = Objects.Real then
            obj.val_ := val(int32, floor(M.x))
            M.res := 0
          elsif M.class = Objects.LongReal then
            obj.val_ := val(int32, floor(M.x))
            M.res := 0
          end

        else
          Gadgets.objecthandle(obj, M)
        end

      elsif M.id = Objects.enum then
        M.Enum("Value")
        Gadgets.objecthandle(obj, M)
      end

    | Objects.PFileMsg:
      if M.id = Objects.store then
        Files.WriteNum(@M.R, VersionAbstract)
        Files.WriteLInt(@M.R, obj.val_)
        Gadgets.objecthandle(obj, M)
      elsif M.id = Objects.load then
        Files.ReadNum(@M.R, @ver)
        if ver = VersionNo then
          // old
          Files.ReadLInt(@M.R, @obj.val_)
        elsif ver = VersionAbstract then
          Files.ReadLInt(@M.R, @obj.val_)
          Gadgets.objecthandle(obj, M)
        else
          Texts.WriteString(@W, "Version ")
          Texts.WriteInt(@W, VersionAbstract, 3)
          Texts.WriteString(@W, " of integer cannot read version ")
          Texts.WriteInt(@W, ver, 3)
          Texts.WriteLn(@W)
          Log()
          halt(42)
        end
      end

    | Objects.PCopyMsg:
      if M.stamp = obj.stamp then
        M.obj := obj.dlink
      else
        newgc(obj2)
        obj.stamp := M.stamp
        obj.dlink := obj2
        CopyInteger(M, obj, obj2)
        M.obj := obj2
      end

    else
      Gadgets.objecthandle(obj, M)
    end
  end
end IntegerHandler

procedure InitInteger*(obj: Integer)
begin
  obj.handle := IntegerHandler
  obj.val_ := 0
end InitInteger

procedure NewInteger*()
  var
    obj: Integer
begin
  newgc(obj)
  InitInteger(obj)
  Objects.NewObj := obj
end NewInteger

procedure CopyReal*(M: pointer to Objects.CopyMsg; from, to_: Real)
begin
  Gadgets.CopyObject(M, from, to_)
  to_.val_ := from.val_
end CopyReal

procedure RealHandler*(obj: Objects.Object; M: pointer to Objects.ObjMsg)
  var
    obj2: Real
    ver: int32
begin
  case obj of
  | Real:
    case M of
    | Objects.PAttrMsg:
      if M.id = Objects.get then
        if M.name = "Gen" then
          copy(@M.s, "BasicGadgets.NewReal", 64)
          M.class := Objects.String
          M.res := 0
        elsif M.name = "Value" then
          M.y := obj.val_
          M.class := Objects.LongReal
          M.res := 0
        else
          Gadgets.objecthandle(obj, M)
        end

      elsif M.id = Objects.set_ then
        if M.name = "Value" then
          if M.class = Objects.LongReal then
            obj.val_ := M.y
            M.res := 0
          elsif M.class = Objects.Real then
            obj.val_ := val(longreal, M.x)
            M.res := 0
          elsif M.class = Objects.Int then
            obj.val_ := val(longreal, M.i)
            M.res := 0
          elsif M.class = Objects.String then
            Strings.StrToReal(@M.s, @obj.val_)
            M.res := 0
          end

        else
          Gadgets.objecthandle(obj, M)
        end

      elsif M.id = Objects.enum then
        M.Enum("Value")
        Gadgets.objecthandle(obj, M)
      end

    | Objects.PFileMsg:
      if M.id = Objects.store then
        Files.WriteNum(@M.R, VersionAbstract)
        Files.WriteLReal(@M.R, obj.val_)
        Gadgets.objecthandle(obj, M)
      elsif M.id = Objects.load then
        Files.ReadNum(@M.R, @ver)
        if ver = VersionNo then
          // old
          Files.ReadLReal(@M.R, @obj.val_)
        elsif ver = VersionAbstract then
          Files.ReadLReal(@M.R, @obj.val_)
          Gadgets.objecthandle(obj, M)
        else
          Texts.WriteString(@W, "Version ")
          Texts.WriteInt(@W, VersionAbstract, 3)
          Texts.WriteString(@W, " of real cannot read version ")
          Texts.WriteInt(@W, ver, 3)
          Texts.WriteLn(@W)
          Log()
          halt(42)
        end
      end

    | Objects.PCopyMsg:
      if M.stamp = obj.stamp then
        M.obj := obj.dlink
      else
        newgc(obj2)
        obj.stamp := M.stamp
        obj.dlink := obj2
        CopyReal(M, obj, obj2)
        M.obj := obj2
      end

    else
      Gadgets.objecthandle(obj, M)
    end
  end
end RealHandler

procedure InitReal*(obj: Real)
begin
  obj.handle := RealHandler
  obj.val_ := val(longreal, 0)
end InitReal

procedure NewReal*()
  var
    obj: Real
