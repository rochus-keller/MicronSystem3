VAR i, a, b: INTEGER;
BEGIN
i := 0;
WHILE (mask[i] > " ") & (mask[i] # "/") DO pat[i] := mask[i]; INC(i);  END;
pat[i] := 0X;
Floppy.OpenVol(a, b);
Floppy.Enumerate(EntryHandler);
Floppy.CloseVol();
