(*
(** Same as Directory, except the files on Diskette are searched. This command is not functional on all platforms. *)
PROCEDURE Diskette*; (* "mask" "objname" *)
VAR S: Attributes.Scanner; mask: ARRAY 32 OF CHAR; o: Objects.Object;
text: Texts.Text;
BEGIN
Attributes.OpenScanner(S,Oberon.Par.text,Oberon.Par.pos); Attributes.Scan(S);
IF (S.class = Attributes.Name) OR (S.class  = Attributes.String)  THEN Copy(S.s, mask);
Attributes.Scan(S);
IF (S.class = Attributes.Name) OR (S.class = Attributes.String) THEN
Copy(S.s, S.s); o := Gadgets.FindObj(Gadgets.context, S.s);
IF (o # NIL) & (o IS List) THEN
WITH o: List DO
NEW(text); Texts.Open(text, "");
GetDiskette(mask, text); o.beg := NIL; o.items := NIL; o.noitems := 0;
InsertItems(o, text, 0, text.len);
END
END
END
END
END Diskette;
*)

procedure LibDir(const name: pointer to array of char; text: Texts.Text)
  var
    L: Objects.Library
    ref, i: int16
    libName, objName: array 32 of char
begin
  i := 0
  while (name[i] # 0X) & (name[i] # ".") do
    inc(i)
  end
  name[i] := 0X
  copy(@libName, name, 32)
  name[i] := "."
  name[i + 1] := "L"
  name[i + 2] := "i"
  name[i + 3] := "b"
  name[i + 4] := 0X

  L := Objects.ThisLibrary(name)
  if L # nil then
    ref := 0
    repeat
      Objects.GetName(@L.dict, ref, @objName, 32)
      if (objName[0] # 0X) & (objName[0] >= "A") & (objName[0] <= "Z") then
        Texts.WriteString(@W, @libName)
        Texts.Write(@W, ".")
        Texts.WriteString(@W, @objName)
        Texts.WriteLn(@W)
      end

      inc(ref)
    until ref = L.maxref
  end

  Texts.Append(text, W.buf)
end LibDir

(** Used in the form:

Lists.Library <Libname> <ObjName>

Inserts a list of all object names in <Libname> into the list named <ObjName> in the current context. <Libname> must not include the ".Lib" extension.
*)
procedure Library*()
  // "lib" "objname"
  var
    S: Attributes.Scanner
    name: array 32 of char
    o: Objects.Object
    text: Texts.Text
begin
  Attributes.OpenScanner(@S, Oberon.Par.text, Oberon.Par.pos)
  Attributes.Scan(@S)
  if (S.class = Attributes.Name) or (S.class = Attributes.String) then
    Copy(@S.s, @name)
    Attributes.Scan(@S)
    if (S.class = Attributes.Name) or (S.class = Attributes.String) then
      Copy(@S.s, @S.s)
      o := Gadgets.FindObj(Gadgets.context, @S.s)
      if (o # nil) & (o is List) then
        case o of
        | List:
          newgc(text)
          Texts.Open(text, "")
          LibDir(@name, text)
          o.beg := nil
          o.items := nil
          o.noitems := 0
          InsertItems(o, text, 0, text.len_)
        end
      end
    end
  end
end Library

procedure Init()
  var
    s: Texts.Scanner
begin
  Oberon.OpenScanner(@s, "Gadgets.ListScrollDelay")
  if (s.class = Texts.Int) & (s.i > 0) then
    waittime := s.i
  else
    waittime := 100
  end

  waittime := obdiv(waittime * Input.TimeUnit, 1000)
end Init

type CMD_ = procedure()

procedure cmd_*(i: int32; name: ^array 32 of char): CMD_
begin
  if i = 0 then if name # nil then name^ := "NewList" end return NewList end
  if i = 1 then if name # nil then name^ := "Directory" end return Directory end
  if i = 2 then if name # nil then name^ := "Library" end return Library end
  return nil
end cmd_

begin
  Modules.Register("Lists", cmd_)
  Texts.OpenWriter(@W)
  Init()
end Lists.
