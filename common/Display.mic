  image[11] := {}
  image[12] := {}
  image[13] := {}
  image[14] := {}
  image[15] := {}
  ticks := NewPattern(16, 16, @image)

  image[0] := -{}
  image[1] := -{}
  image[2] := -{}
  image[3] := -{}
  image[4] := -{}
  image[5] := -{}
  image[6] := -{}
  image[7] := -{}
  solid := NewPattern(16, 8, @image)
end CreatePatterns

// Return the format of a display region, for TransferBlock.
procedure TransferFormat*(x: int32): int32
begin
  case disp.format of
    1 (* AosDisplays.index8 *):
    return index8
  | 2 (* AosDisplays.color565 *):
    return color565
  | 3 (* AosDisplays.color888 *):
    return color888
  | 4 (* AosDisplays.color8888 *):
    return color8888
  else
    return unknown
  end
  return 0 // TODO o2m: Micron requires a result on all control paths
end TransferFormat

// Transfer a block of pixels in display format to (mode = set) or from (mode = get)  the display.  Pixels in the rectangular area are transferred from bottom to top and left to right.  The pixels are transferred to or from buf, starting at ofs, and with line increment stride, which may be < 0.
procedure TransferBlock*(buf: pointer to array of char; buf_len: int32; ofs, stride, x, y, w, h, mode: int32)
  var
    rdx, tdy: int32
begin
  rdx := x + w - 1 // (x,y) bottom left & (rdx,tdy) top right
  tdy := y + h - 1
  if (x <= clipX2) & (y <= clipY2) & (rdx >= clipX1) & (tdy >= clipY1) then
    if x < clipX1 then
      dec(w, clipX1 - x)
      inc(ofs, (clipX1 - x) * disp.format)
      x := clipX1
    end
    if y < clipY1 then
      dec(h, clipY1 - y)
      inc(ofs, (clipY1 - y) * stride)
      y := clipY1
    end
    if rdx > clipX2 then
      dec(w, rdx - clipX2)
    end
    if tdy > clipY2 then
      dec(h, tdy - clipY2)
    end
    if (w > 0) & (h > 0) then
      disp.Transfer(buf, buf_len, ofs + (h - 1) * stride, -stride, x, height - h - y, w, h, mode)
    end
  end
end TransferBlock

// Change screen mode.
procedure SetMode*(x: int32; s: set)
begin
  disp := AosDisplays.main
  height := disp.height
  Left := 0
  ColLeft := 0
  Bottom := 0
  Unit := disp.unit
  UBottom := val(int16, -disp.offscreen)
  Width := val(int16, disp.width)
  Height := val(int16, height)
  ResetClip()
end SetMode

// Display a picture.  Used internally by Pictures module only.
procedure DisplayBlock*(adr: AnyPtr; dx, dy, w, h, sx, sy, mode: int32)
  var
    pw, pd: int32
    src, dst: AnyPtr
    rdx, tdy, col: int32
    ch, prev, prevmap: char
begin
  rdx := sx + w - 1 // (sx,sy) bottom left & (rdx,tdy) top right
  tdy := sy + h - 1
  if (sx <= clipX2) & (sy <= clipY2) & (rdx >= clipX1) & (tdy >= clipY1) then
    if sx < clipX1 then
      dec(w, clipX1 - sx)
      inc(dx, clipX1 - sx)
      sx := clipX1
    end
    if sy < clipY1 then
      dec(h, clipY1 - sy)
      inc(dy, clipY1 - sy)
      sy := clipY1
    end
    if rdx > clipX2 then
      dec(w, rdx - clipX2)
    end
    if tdy > clipY2 then
      dec(h, tdy - clipY2)
    end
    if (w > 0) & (h > 0) then
      pd := 0
      cast(Int16Ptr, @pd)^ := cast(Int16Ptr, ptroff(adr, 4))^
      if pd = 8 then
        pw := cast(Int32Ptr, ptroff(adr, 8))^
        src := cast(AnyPtrPtr, ptroff(adr, 12))^
        inc(src, (dy + h - 1) * pw + dx) // top left corner
        if w * h * disp.format + 1 > buflen then
          buflen := w * h * disp.format + 1 // +1 for *** below
          newgc(buf, buflen)
        end
        dst := cast(AnyPtr, @buf[0])
        case disp.format of
          1 (* AosDisplays.index8 *):
          prev := 0X
          prevmap := chr(disp.ColorToIndex(palette[ord(prev)]))
          for tdy := 0 to h - 1 do
            for rdx := 0 to w - 1 do
              ch := cast(CharPtr, src)^
              inc(src)
              if ch # prev then
                prev := ch
                prevmap := chr(disp.ColorToIndex(palette[ord(prev)]))
              end

              cast(CharPtr, dst)^ := prevmap
              inc(dst)
            end

            inc(src, -w - pw)
          end

        | 2 (* AosDisplays.color565 *):
          for tdy := 0 to h - 1 do
            for rdx := 0 to w - 1 do
              ch := cast(CharPtr, src)^
              inc(src)
              col := palette[ord(ch)]
              cast(Int16Ptr, dst)^ := val(int16, ord(bset(usig(asr(col, 8))) * {11..15} + 
                    bset(usig(asr(col, 5))) * {5..10} + bset(usig(asr(col, 3))) * {0..4}))

              inc(dst, 2)
            end

            inc(src, -w - pw)
          end

        | 3 (* AosDisplays.color888 *), 4 (* AosDisplays.color8888 *):
          col := disp.format // size
          for tdy := 0 to h - 1 do
            for rdx := 0 to w - 1 do
              ch := cast(CharPtr, src)^
              inc(src)
              cast(Int32Ptr, dst)^ := palette[ord(ch)] // ** possible 32-bit write to 24-bit value
              inc(dst, col)
            end

            inc(src, -w - pw)
          end
        end

        disp.Transfer(buf, buflen, 0, w * disp.format, sx, height - h - sy, w, h, set_)
      else
      end // depth not supported
      // skip
    end
  end
end DisplayBlock

// Return address of display located at x, or 0 if not supported.
procedure Map*(x: int32): int32
begin
  return 0
end Map

procedure LoadDriver()
  var
    m: Modules.Module
    c: Modules.Command
    name: array 32 of char
begin
  Kernel.GetConfig("DDriver", @name, 32)
  if name = "" then
    copy(@name, "DisplayPermedia2", 32)
  end
  m := Modules.ThisMod(@name)
  if m # nil then
    c := Modules.ThisCommand(m, "Install")
    if c # nil then
      c()
    end
  else
    c := nil
  end

  if c = nil then
    Kernel.WriteString("Display: ")
    Kernel.WriteString(@Modules.resMsg)
    Kernel.WriteLn()
  end
end LoadDriver

type CMD_ = procedure()

procedure cmd_*(i: int32; name: ^array 32 of char): CMD_
begin
  if i = 0 then if name # nil then name^ := "ResetClip" end return ResetClip end
  return nil
end cmd_

begin
  Modules.Register("Display", cmd_)
  assert((get = AosDisplays.get) & (set_ = AosDisplays.set_))
  LoadDriver()
  newgc(buf, 8192)
  pattern := nil
  CreatePatterns()
  SetMode(0, {})
end Display.
