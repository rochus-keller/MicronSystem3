module Display [level=5]

import AosDisplays := Displays, Kernel, Modules, Objects, SYS, DisplayLinear
// pjm

// Native Oberon display module based on Displays.

(**
Module Display provides the display drawing primitives and the base type of the visual objects, called Frames.
*)

const
  BG* = 0 // Background, foreground colors.
  FG* = 15

  // Drawing operation modes.
  replace* = 0 // replace destination.
  paint* = 1 // paint over destination.
  invert* = 2 // invert destination.

  // Message ids.
  remove* = 0 // ControlMsg id.
  suspend* = 1
  restore* = 2
  newprinter* = 3
  reduce* = 0 // ModifyMsg id.
  extend* = 1
  move* = 2
  display* = 0 // ModifyMsg mode.
  state* = 1
  screen* = 0 // DisplayMsg device
  printer* = 1
  full* = 0 // DisplayMsg id.
  area* = 1
  contents* = 2
  get* = 0 // SelectMsg id.
  set_* = 1
  reset* = 2
  drop* = 0 // ConsumeMsg id.
  integrate* = 1

  // TransferFormat types.
  unknown* = 0
  index8* = 8
  color555* = 16
  color565* = 17
  color664* = 18
  color888* = 24
  color8888* = 32

type
  AnyPtr = pointer to byte // helper type for Oberon addresses and SYSTEM.PTR
  CharPtr = pointer to char // helper type for a variable reinterpreted by SYSTEM.VAL
  Int16Ptr = pointer to int16 // helper type for a variable reinterpreted by SYSTEM.VAL
  Int32Ptr = pointer to int32 // helper type for a variable reinterpreted by SYSTEM.VAL
  AnyPtrPtr = pointer to AnyPtr // helper type for a variable reinterpreted by SYSTEM.VAL

  Color* = int32

  Pattern* = int32
  PatternPtr = pointer to PatternPtrDesc
  // w = buf[0], h = buf[1], pixmap = buf[2..]

  List = pointer to ListDesc
  ListDesc = record
    next: List
    pat: PatternPtr
  end

  Frame* = pointer to FrameDesc // Base type of all displayable objects.
  FrameDesc* = object (Objects.ObjDesc)
    next*: Frame // Sibling, child pointers.
    dsc*: Frame
    X*: int16 // Coordinates.
    Y*, W*, H*: int16
  end

  FrameMsg* = object (Objects.ObjMsg)
    // Base type of messages sent to frames.
    F*: Frame // target
    // Message target, NIL for broadcast.
    x*: int16 // Message origin.
    y*, res*: int16 // Result code: <0 = error or no response, >=0 response.
  end
  PFrameMsg* = pointer to FrameMsg

  ControlMsg* = object (FrameMsg)
    id*: int16 // remove, suspend, restore.
  end
  PControlMsg* = pointer to ControlMsg

  ModifyMsg* = object (FrameMsg)
    // Change coordinates in container frame.
    id*: int16 // reduce, extend, move.
    mode*: int16 // Modes display, state.
    dX*: int16 // Change from old coordinates (delta).
    dY*, dW*, dH*, X*: int16 // New coordinates.
    Y*, W*, H*: int16
  end
  PModifyMsg* = pointer to ModifyMsg

  DisplayMsg* = object (FrameMsg)
    // Display a frame, a part of it or its contents.
    device*: int16 // screen, printer
    id*: int16 // full, area, contents.
    u*: int16 // Area to be restored.
    v*, w*, h*: int16
  end
  PDisplayMsg* = pointer to DisplayMsg

  LocateMsg* = object (FrameMsg)
    // Locate frame in display space.
    loc*: Frame // Result.
    X*: int16 // Absolute location.
    Y*, u*: int16 // Relative coordinates in loc.
    v*: int16
  end
  PLocateMsg* = pointer to LocateMsg

  SelectMsg* = object (FrameMsg)
    // Selection control.
    id*: int16 // get, set, reset.
    time*: int32 // Time of selection.
    sel*: Frame // Parent of selection.
    obj*: Objects.Object // List of objects involved, linked with slink.
  end
  PSelectMsg* = pointer to SelectMsg

  ConsumeMsg* = object (FrameMsg)
    // Drop, integrate frames.
    id*: int16 // drop, integrate.
    u*: int16 // Relative coordinates in destination when drop.
    v*: int16
    obj*: Objects.Object // List of objects to be consumed, linked with slink.
  end
  PConsumeMsg* = pointer to ConsumeMsg

  MsgProc* = procedure(M: pointer to FrameMsg)

  PatternPtrDesc = record
    buf: array 8192 of char
  end

var
  Unit*: int32 // RasterUnit = Unit/36000 mm

  Left*: int16 // Left margin of black-and-white screen.
  ColLeft*: int16 // Left margin of secondary display, often same as Left.
  Bottom*: int16 // Bottom of primary map.
  UBottom*: int16 // Bottom of offscreen area (negative), 0 if not supported.
  Width*: int16 // Display width.
  Height*: int16 // Display height.

  arrow*: AnyPtr // Oberon cursor.
  star*: AnyPtr // Star marker to mark documents and viewers.
  cross*: AnyPtr // Insertion marker.
  downArrow*: AnyPtr // Marker to indicate disk operation.
  hook*: AnyPtr // Text caret pattern.
  grey0*: AnyPtr // Simulated grey levels.
  grey1*, grey2*, ticks*, solid*: AnyPtr
  Broadcast*: MsgProc // Message broadcast to all frames in the display space.

  palette: array 256 of int32
  clipX1: int32 // bottom left corner & top right corner, in Oberon coordinates
  clipY1, clipX2, clipY2: int32
  pattern: List

  buf: pointer to array of char // for DisplayBlock
  buflen: int32

  disp: AosDisplays.PDisplay
  height: int32

procedure ^ FillPattern*(col: int32; pat: AnyPtr; px, py, x, y, w, h, mode: int32)

// Change color palette entry. 0 <= col, red, green, blue < 256.
procedure SetColor*(col, red, green, blue: int32)
begin
  palette[band(col, 255)] := sigc(shl(val(int32, sigc(shl(val(int32, red), 8)) + green), 8)) + blue
end SetColor

// Retrieve color palette entry or color components. 0 <= red, green, blue < 256.
procedure GetColor*(col: int32; red, green, blue: pointer to int16)
begin
  if col >= 0 then
    col := palette[band(col, 255)]
  end
  red^ := val(int16, band(asr(col, 16), 255))
  green^ := val(int16, band(asr(col, 8), 255))
  blue^ := val(int16, band(col, 255))
end GetColor

// Return color with specified components. 0 <= red, green, blue < 256.
procedure RGB*(red, green, blue: int32): int32
begin
  return (-2147483647-1) + sigc(shl(val(int32, red), 16)) + sigc(shl(val(int32, green), 8)) + blue
end RGB

// Returns the number of bits per pixel for the given x coordinate. Typical values are 1, 4, 8 (maximum 8).
procedure Depth*(x: int32): int16
begin
  return 8
end Depth

// Returns if truecolor values are supported in the interface.
procedure TrueColor*(x: int32): boolean
begin
  return true
end TrueColor

// Get the current clip rectangle.
procedure GetClip*(x, y, w, h: pointer to int16)
begin
  x^ := val(int16, clipX1)
  y^ := val(int16, clipY1)
  w^ := val(int16, clipX2 - clipX1 + 1)
  h^ := val(int16, clipY2 - clipY1 + 1)
end GetClip

// Set the new clipping rectangle.
procedure SetClip*(x, y, w, h: int32)
begin
  clipX1 := x
  clipY1 := y
  clipX2 := clipX1 + w - 1
  clipY2 := clipY1 + h - 1
end SetClip

// Intersect with current clip rectangle resulting in a new clip rectangle.
procedure AdjustClip*(x, y, w, h: int32)
  var
    x2, y2: int32
begin
  x2 := x + w - 1
  y2 := y + h - 1
  if x > clipX1 then
    clipX1 := x
  end
  if y > clipY1 then
    clipY1 := y
  end
  if x2 < clipX2 then
    clipX2 := x2
  end
  if y2 < clipY2 then
    clipY2 := y2
  end
end AdjustClip

// Reset the current clipping rectangle to the whole display, including offscreen area.
procedure ResetClip*()
begin
  clipX1 := 0
  clipY1 := UBottom
  clipX2 := disp.width - 1
  clipY2 := height - 1
end ResetClip

// Copy source block SX, SY, W, H to destination DX, DY using operation mode. A block is given by its lower left corner X, Y 
// and its dimension W, H.
procedure CopyBlock*(sx, sy, w, h, dx, dy, mode: int32)
begin
  disp.Copy(sx, height - sy - h, w, h, dx, height - dy - h)
end CopyBlock

// Place a dot of color col in operation mode at x, y. Effect equivalent to ReplConst with a block of size 1, 1.
procedure CopyPattern*(col: int32; pat: AnyPtr; x, y, mode: int32)
  var
    pw, ph, stride: int32
    p: PatternPtr
begin
  p := cast(PatternPtr, pat)
  pw := val(int32, ord(p.buf[0]))
  ph := val(int32, ord(p.buf[1]))
  if (x >= clipX1) & (y >= clipY1) & (x + pw - 1 <= clipX2) & (y + ph - 1 <= clipY2) then
    // completely visible
    if col >= 0 then
      col := palette[band(col, 255)]
    end
    stride := asr(pw + 7, 3)
    case mode of
      0 (* replace *):
      disp.Mask(@p.buf, 16 + (ph - 1) * stride * 8, -stride, band(col, 16777215), palette[BG], x, height - y - ph, pw, ph)

    | 2 (* invert *):
      disp.Mask(@p.buf, 16 + (ph - 1) * stride * 8, -stride, band(col, 16777215) + AosDisplays.invert, 
                  val(int32, AosDisplays.trans), x, height - y - ph, pw, ph)

    else
      // paint
      disp.Mask(@p.buf, 16 + (ph - 1) * stride * 8, -stride, band(col, 16777215), val(int32, AosDisplays.trans), x, height - y - ph, pw, ph)
    end

  elsif (x + pw - 1 >= clipX1) & (y + ph - 1 >= clipY1) & (x <= clipX2) & (y <= clipY2) then
    // partially visible
    FillPattern(col, pat, x, y, x, y, pw, ph, mode)
  else
  end // not visible
  // skip
end CopyPattern

// Replicate pattern pat in color col into block x, y, w, h using operation mode, proceeding from left to right and from bottom to top, 
// starting at lower left corner. The pattern origin is placed at px, py.
procedure FillPattern*(col: int32; pat: AnyPtr; px, py, x, y, w, h, mode: int32)
  var
    pw, ph, rdx, lpx, ldw, lsx, rdw, tdy, bpy, cdy, csy, cdh, cdx, csx, stride, fg, bg: int32
    p: PatternPtr
begin
  // See Displays.Display.Text for documentation

  rdx := x + w - 1 // (x,y) bottom left & (rdx,tdy) top right
  tdy := y + h - 1
  if (x <= clipX2) & (y <= clipY2) & (rdx >= clipX1) & (tdy >= clipY1) then
    if x < clipX1 then
      dec(w, clipX1 - x)
      x := clipX1
    end
    if y < clipY1 then
      dec(h, clipY1 - y)
      y := clipY1
    end
    if rdx > clipX2 then
      dec(w, rdx - clipX2)
    end
    if tdy > clipY2 then
      dec(h, tdy - clipY2)
    end
    if (w > 0) & (h > 0) then
      if col >= 0 then
        col := palette[band(col, 255)]
      end
      case mode of
        0 (* replace *):
        fg := band(col, 16777215)
        bg := palette[BG]
      | 2 (* invert *):
        fg := band(col, 16777215) + AosDisplays.invert
        bg := val(int32, AosDisplays.trans)
      else
        fg := band(col, 16777215)
        bg := val(int32, AosDisplays.trans)
      end

      p := cast(PatternPtr, pat)
      pw := val(int32, ord(p.buf[0]))
      ph := val(int32, ord(p.buf[1]))
      if (pw > 0) & (ph > 0) then
        // rest of code copied from eos' TileBuffer
        stride := asr(pw + 7, 3)
        inc(px, obdiv(x - px, pw) * pw)
        inc(py, obdiv(y - py, ph) * ph)
        rdx := x + w
        lpx := px + pw
        ldw := lpx - x
        lsx := pw - ldw
        if ldw > w then
          ldw := w
        end
        rdw := obmod(rdx - px, pw)
        tdy := y + h
        bpy := py + ph
        cdy := y
        csy := y - py
        if (py < y) & (bpy < tdy) then
          cdh := bpy - cdy
          cdx := x
          csx := lsx
          if px < x then
            disp.Mask(@p.buf, 16 + (csy + cdh - 1) * stride * 8 + lsx, -stride, fg, bg, cdx, height - cdh - cdy, ldw, cdh)
            csx := 0
            cdx := lpx
          end

          while cdx + pw <= rdx do
            disp.Mask(@p.buf, 16 + (csy + cdh - 1) * stride * 8, -stride, fg, bg, cdx, height - cdh - cdy, pw, cdh)
            inc(cdx, pw)
          end

          if cdx < rdx then
            disp.Mask(@p.buf, 16 + (csy + cdh - 1) * stride * 8 + csx, -stride, fg, bg, cdx, height - cdh - cdy, rdw, cdh)
          end

          csy := 0
          cdy := bpy
        end

        while cdy + ph <= tdy do
          cdx := x
          csx := lsx
          if px < x then
            // draw left border
            disp.Mask(@p.buf, 16 + (ph - 1) * stride * 8 + lsx, -stride, fg, bg, cdx, height - ph - cdy, ldw, ph)
            csx := 0
            cdx := lpx
          end

          while cdx + pw <= rdx do
            disp.Mask(@p.buf, 16 + (ph - 1) * stride * 8, -stride, fg, bg, cdx, height - ph - cdy, pw, ph)
            inc(cdx, pw)
          end

          if cdx < rdx then
            // draw right border
            disp.Mask(@p.buf, 16 + (ph - 1) * stride * 8 + csx, -stride, fg, bg, cdx, height - ph - cdy, rdw, ph)
          end

          inc(cdy, ph)
        end

        if cdy < tdy then
          // draw top border
          cdh := tdy - cdy
          cdx := x
          csx := lsx
          if px < x then
            // draw top left corner
            disp.Mask(@p.buf, 16 + (csy + cdh - 1) * stride * 8 + lsx, -stride, fg, bg, cdx, height - cdh - cdy, ldw, cdh)
            csx := 0
            cdx := lpx
          end

          while cdx + pw <= rdx do
            disp.Mask(@p.buf, 16 + (csy + cdh - 1) * stride * 8, -stride, fg, bg, cdx, height - cdh - cdy, pw, cdh)
            inc(cdx, pw)
          end

          if cdx < rdx then
            // draw top right corner
            disp.Mask(@p.buf, 16 + (csy + cdh - 1) * stride * 8 + csx, -stride, fg, bg, cdx, height - cdh - cdy, rdw, cdh)
          end
        end
      end
    end
  end
end FillPattern

// Like FillPattern, but the pattern origin is placed at 0, 0.
procedure ReplPattern*(col: int32; pat: AnyPtr; x, y, w, h, mode: int32)
begin
  FillPattern(col, pat, 0, 0, x, y, w, h, mode)
end ReplPattern

// Block fill in color col and operation mode. *
procedure ReplConst*(col, x, y, w, h, mode: int32)
  var
    rx, ty: int32
begin
  rx := x + w - 1 // (x,y) bottom left & (rx,ty) top right
  ty := y + h - 1
  if (x <= clipX2) & (y <= clipY2) & (rx >= clipX1) & (ty >= clipY1) then
    if x < clipX1 then
      dec(w, clipX1 - x)
      x := clipX1
    end
    if y < clipY1 then
      dec(h, clipY1 - y)
      y := clipY1
    end
    if rx > clipX2 then
      dec(w, rx - clipX2)
    end
    if ty > clipY2 then
      dec(h, ty - clipY2)
    end
    if (w > 0) & (h > 0) then
      if col >= 0 then
        col := palette[band(col, 255)]
      end
      if mode = invert then
        disp.Fill(band(col, 16777215) + AosDisplays.invert, x, height - y - h, w, h)
      else
        disp.Fill(band(col, 16777215), x, height - y - h, w, h)
      end
    end
  end
end ReplConst

// Place a dot of color col in operation mode at x, y. Effect equivalent to ReplConst with a block of size 1, 1.
procedure Dot*(col, x, y, mode: int32)
begin
  if (x <= clipX2) & (y <= clipY2) & (x >= clipX1) & (y >= clipY1) then
    if col >= 0 then
      col := palette[band(col, 255)]
    end
    if mode = invert then
      disp.Dot(band(col, 16777215) + AosDisplays.invert, x, height - y - 1)
    else
      disp.Dot(band(col, 16777215), x, height - y - 1)
    end
  end
end Dot

// Returns the dimensions of a pattern.
procedure GetDim*(pat: AnyPtr; w, h: pointer to int16)
  var
    ch: char
begin
  ch := cast(CharPtr, pat)^
  w^ := val(int16, ord(ch))
  ch := cast(CharPtr, ptroff(pat, 1))^
  h^ := val(int16, ord(ch))
end GetDim

// Define a new pattern.
procedure NewPattern*(w, h: int32; image: pointer to array of set): AnyPtr
  var
    len_: int32
    src, dest: AnyPtr
    i: int32
    p: PatternPtr
    pl: List
    a: AnyPtr
begin
  len_ := asr(w + 7, 3)
  Kernel.NewSys(@a, 4 + len_ * h) // SYSTEM.NEW(p, 4 + len*h); a pattern lives forever
  p := cast(PatternPtr, a)
  p.buf[0] := chr(w)
  p.buf[1] := chr(h)
  src := cast(AnyPtr, @image[0])
  dest := cast(AnyPtr, @p.buf[2])
  i := 0
  while i < h do
    SYS.MOVE(src, dest, len_)
    inc(src, 4)
    inc(dest, len_)
    inc(i)
  end
  newgc(pl) // put in list to avoid GC
  pl.pat := p
  pl.next := pattern
  pattern := pl
  assert(cast(AnyPtr, @p.buf[0]) = cast(AnyPtr, p))
  return cast(AnyPtr, @p.buf[0])
end NewPattern

