  image[14] := {0,2,4,6,8,10,12,14}
  image[15] := {1,3,5,7,9,11,13,15}
  grey1 := NewPattern(16, 16, @image)

  image[0] := {0,1,4,5,8,9,12,13}
  image[1] := {0,1,4,5,8,9,12,13}
  image[2] := {2,3,6,7,10,11,14,15}
