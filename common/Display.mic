  image[10] := {5..7}
  image[11] := {5..7}
  image[12] := {5..7}
  image[13] := {5..7}
  image[14] := {}
  downArrow := NewPattern(11, 15, @image)

  image[0] := {0,4,8,12}
  image[1] := {}
  image[2] := {2,6,10,14}
  image[3] := {}
  image[4] := {0,4,8,12}
