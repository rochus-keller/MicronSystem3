// --- dstCopy Transfer ---

procedure EmptyTransfer(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
begin
end EmptyTransfer

// --- srcOverDst Transfer ---

// A1
procedure AnyOverA1(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    out: char
    pix: Pixel
begin
  out := cast(CharPtr, dadr)^
  while len_ > 0 do
    mode.src.unpack(@mode.src, sadr, sbit, @pix)
    if pix[a] >= 80X then
      out := Set[ord(out)][dbit]
    end

    sbit := sbit + mode.src.bpp
    inc(sadr, asr(sbit, 3))
    sbit := band(sbit, 7)
    inc(dbit)
    dec(len_)
    if dbit = 8 then
      cast(CharPtr, dadr)^ := out
      inc(dadr)
      dbit := 0
      out := cast(CharPtr, dadr)^
    end
  end

  cast(CharPtr, dadr)^ := out
end AnyOverA1

procedure A1OverA1(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    in_, out: char
begin
  in_ := cast(CharPtr, sadr)^
  out := cast(CharPtr, dadr)^
  while len_ > 0 do
    if Bit[ord(in_)][sbit] then
      out := Set[ord(out)][dbit]
    end

    inc(sbit)
    inc(dbit)
    dec(len_)
    if sbit = 8 then
      inc(sadr)
      sbit := 0
      in_ := cast(CharPtr, sadr)^
    end

    if dbit = 8 then
      cast(CharPtr, dadr)^ := out
      inc(dadr)
      dbit := 0
      out := cast(CharPtr, dadr)^
    end
  end

  cast(CharPtr, dadr)^ := out
end A1OverA1

procedure A8OverA1(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    in_, out: char
begin
  out := cast(CharPtr, dadr)^
  while len_ > 0 do
    in_ := cast(CharPtr, sadr)^
    if in_ >= 80X then
      out := Set[ord(out)][dbit]
    end

    inc(sadr)
    inc(dbit)
    dec(len_)
    if dbit = 8 then
      cast(CharPtr, dadr)^ := out
      inc(dadr)
      dbit := 0
      out := cast(CharPtr, dadr)^
    end
  end

  cast(CharPtr, dadr)^ := out
end A8OverA1

procedure BGRA8888OverA1(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    in_, out: char
begin
  out := cast(CharPtr, dadr)^
  while len_ > 0 do
    in_ := cast(CharPtr, ptroff(sadr, a))^
    if in_ >= 80X then
      out := Set[ord(out)][dbit]
    end

    inc(sadr, 4)
    inc(dbit)
    dec(len_)
    if dbit = 8 then
      cast(CharPtr, dadr)^ := out
      inc(dadr)
      dbit := 0
      out := cast(CharPtr, dadr)^
    end
  end

  cast(CharPtr, dadr)^ := out
end BGRA8888OverA1

procedure A1OverAny(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    in_: char
begin
  in_ := cast(CharPtr, sadr)^
  while len_ > 0 do
    if Bit[ord(in_)][sbit] then
      mode.dst.pack(@mode.dst, dadr, dbit, @mode.buf)
    end

    inc(sbit)
    dbit := dbit + mode.dst.bpp
    inc(dadr, asr(dbit, 3))
    dbit := band(dbit, 7)
    dec(len_)
    if sbit = 8 then
      inc(sadr)
      sbit := 0
      in_ := cast(CharPtr, sadr)^
    end
  end
end A1OverAny

procedure A1OverConst8(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    in_: char
begin
  in_ := cast(CharPtr, sadr)^
  while len_ > 0 do
    if Bit[ord(in_)][sbit] then
      cast(CharPtr, dadr)^ := mode.buf[0]
    end

    inc(sbit)
    inc(dadr)
    dec(len_)
    if sbit = 8 then
      inc(sadr)
      sbit := 0
      in_ := cast(CharPtr, sadr)^
    end
  end
end A1OverConst8

