// A8
procedure AnyOverA8(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    pix: Pixel
    b: char
begin
  while len_ > 0 do
    mode.src.unpack(@mode.src, sadr, sbit, @pix)
    if pix[a] = 0FFX then
      cast(CharPtr, dadr)^ := 0FFX
    elsif pix[a] # 0X then
      b := cast(CharPtr, dadr)^
      cast(CharPtr, dadr)^ := chr(val(int32, ord(pix[a])) + obdiv(val(int32, ord(b)) * val(int32, 255 - val(int16, ord(pix[a]))), 255))
    end

    sbit := sbit + mode.src.bpp
    inc(sadr, asr(sbit, 3))
    sbit := band(sbit, 7)
    inc(dadr)
    dec(len_)
  end
end AnyOverA8

procedure A8OverAny(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    dpix: Pixel
begin
  while len_ > 0 do
    mode.buf[a] := cast(CharPtr, sadr)^
    if mode.buf[a] = 0FFX then
      mode.dst.pack(@mode.dst, dadr, dbit, @mode.buf)
    elsif mode.buf[a] # 0X then
      mode.dst.unpack(@mode.dst, dadr, dbit, @dpix)
      Blend(mode.op, @mode.buf, @dpix)
      mode.dst.pack(@mode.dst, dadr, dbit, @dpix)
    end

    inc(sadr)
    dec(len_)
    dbit := dbit + mode.dst.bpp
    inc(dadr, asr(dbit, 3))
    dbit := band(dbit, 7)
  end
end A8OverAny

procedure A8OverA8(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    in_, out: char
begin
  while len_ > 0 do
    in_ := cast(CharPtr, sadr)^
    if in_ = 0FFX then
      cast(CharPtr, dadr)^ := 0FFX
    elsif in_ # 0X then
      out := cast(CharPtr, dadr)^
      cast(CharPtr, dadr)^ := chr(val(int32, ord(in_)) + obdiv(val(int32, ord(out)) * val(int32, 255 - val(int16, ord(in_))), 255))
    end

    inc(sadr)
    inc(dadr)
    dec(len_)
  end
end A8OverA8

// BGRA8888
procedure AnyOverBGRA8888(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    spix, dpix: Pixel
begin
  while len_ > 0 do
    mode.src.unpack(@mode.src, sadr, sbit, @spix)
    if spix[a] = 0FFX then
      SYS.MOVE(cast(AnyPtr, @spix[0]), dadr, 4)
    elsif spix[a] # 0X then
      SYS.MOVE(dadr, cast(AnyPtr, @dpix[0]), 4)
      Blend(mode.op, @spix, @dpix)
      SYS.MOVE(cast(AnyPtr, @dpix[0]), dadr, 4)
    end

    sbit := sbit + mode.src.bpp
    inc(sadr, asr(sbit, 3))
    sbit := band(sbit, 7)
    inc(dadr, 4)
    dec(len_)
  end
end AnyOverBGRA8888

procedure BGRA8888OverAny(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    spix, dpix: Pixel
begin
  while len_ > 0 do
    SYS.MOVE(sadr, cast(AnyPtr, @spix[0]), 4)
    if spix[a] = 0FFX then
      mode.dst.pack(@mode.dst, dadr, dbit, @spix)
    elsif spix[a] # 0X then
      mode.dst.unpack(@mode.dst, dadr, dbit, @dpix)
      Blend(mode.op, @spix, @dpix)
      mode.dst.pack(@mode.dst, dadr, dbit, @dpix)
    end

    inc(sadr, 4)
    dec(len_)
    dbit := dbit + mode.dst.bpp
    inc(dadr, asr(dbit, 3))
    dbit := band(dbit, 7)
  end
end BGRA8888OverAny

procedure BGRA8888OverA8(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    in_, out: char
begin
  while len_ > 0 do
    in_ := cast(CharPtr, ptroff(sadr, a))^
    if in_ = 0FFX then
      cast(CharPtr, dadr)^ := 0FFX
    elsif in_ # 0X then
      out := cast(CharPtr, dadr)^
      cast(CharPtr, dadr)^ := chr(val(int16, ord(in_)) + obdiv(val(int16, ord(out)) * (255 - val(int16, ord(in_))), 255))
    end

    inc(sadr, 4)
    inc(dadr)
    dec(len_)
  end
end BGRA8888OverA8

// find (optimized) pixel transfer procedure for transfer mode and given source and destination formats *
procedure Bind*(mode: pointer to Mode; src, dst: pointer to Format)
  var
    op: int16
    i: int32
begin
  if Same(src, @mode.src) & Same(dst, @mode.dst) then
    assert(mode.transfer # nil)
    return // assume transfer procedure is still valid
  end

  mode.src := src^
  mode.dst := dst^
  copy(@mode.buf, @mode.col, 4)

  // try to convert complex composite operations into simpler ones
  if alpha in src.components * dst.components then
    // source and destination contain alpha information
    op := mode.op
  elsif alpha in src.components then
    // only source contains alpha
    case mode.op of
      4 (* dstOverSrc *):
      op := dstCopy
    | 5 (* srcInDst *):
      op := srcCopy
    | 7 (* srcWithoutDst *):
      op := clear
    | 9 (* srcAtopDst *):
      op := srcOverDst
    | 10 (* dstAtopSrc *):
      op := dstInSrc
    | 11 (* srcXorDst *):
      op := dstWithoutSrc
    else
      op := mode.op
    end

  elsif alpha in dst.components then
    // only destination contains alpha
    case mode.op of
      3 (* srcOverDst *):
      op := srcCopy
    | 6 (* dstInSrc *):
      op := dstCopy
    | 8 (* dstWithoutSrc *):
      op := clear
    | 9 (* srcAtopDst *):
      op := srcInDst
    | 10 (* dstAtopSrc *):
      op := dstOverSrc
    | 11 (* srcXorDst *):
      op := srcWithoutDst
    else
      op := mode.op
    end

  else
    // no alpha in either source or destination
    case mode.op of
      3 (* srcOverDst *), 5 (* srcInDst *), 9 (* srcAtopDst *):
      op := srcCopy
    | 4 (* dstOverSrc *), 6 (* dstInSrc *), 10 (* dstAtopSrc *):
      op := dstCopy
    | 7 (* srcWithoutDst *), 8 (* dstWithoutSrc *), 11 (* srcXorDst *):
      op := clear
    else
      op := mode.op
    end
  end

  if op = clear then
    case dst.code of
      a1:
      mode.transfer := Clear1
    | a8, bgr555, bgr565, bgr466, bgr888, bgra8888:
      mode.transfer := ClearBytes
    | p8:
      mode.buf[0] := chr(PaletteIndex(dst.pal, 0, 0, 0))
      if mode.buf[0] = 0X then
        mode.transfer := ClearBytes
      else
        mode.transfer := ConstCopy8
      end

    | d8:
      mode.buf[0] := chr(Colors.Match(Colors.DisplayIndex, Colors.DisplayBits, 0, 0, 0))
      mode.transfer := ConstCopy8
    else
      mode.transfer := ClearAny
    end

  elsif op = srcCopy then
    case dst.code of
      a1:
      case src.code of
        a1:
        mode.transfer := Copy1
      | a8:
        mode.transfer := A8CopyA1
      | bgra8888:
        mode.transfer := BGRA8888CopyA1
      else
        if alpha in src.components then
          mode.transfer := AnyCopyA1
        else
          mode.transfer := Set1
        end
      end

    | a8:
      case src.code of
        a1:
        mode.transfer := A1CopyA8
      | a8:
        mode.transfer := Copy8
      | bgra8888:
        mode.transfer := BGRA8888CopyA8
      else
        if alpha in src.components then
          mode.transfer := AnyCopyA8
        else
          mode.buf[0] := 0FFX
          mode.transfer := ConstCopy8
        end
      end

    | p8:
      case src.code of
        a1, a8:
        mode.buf[0] := chr(PaletteIndex(dst.pal, val(int16, ord(mode.col[r])), val(int16, ord(mode.col[g])), val(int16, ord(mode.col[b]))))
        mode.transfer := ConstCopy8
      | p8:
        if src.pal = dst.pal then
          mode.transfer := Copy8
        else
          for i := 0 to src.pal.used - 1 do
            mode.map[i] := chr(PaletteIndex(dst.pal, val(int16, ord(src.pal.col[i][r])), val(int16, ord(src.pal.col[i][g])), val(int16, ord(src.pal.col[i][b]))))
          end

          mode.transfer := I8CopyI8
        end

      | d8:
        for i := 0 to 255 do
          mode.map[i] := chr(PaletteIndex(dst.pal, Colors.Red[i], Colors.Green[i], Colors.Blue[i]))
        end

        mode.transfer := I8CopyI8
      | bgr555, bgr565, bgr466:
        mode.transfer := Any16CopyP8
      | bgr888:
        mode.transfer := BGR888CopyP8
      | bgra8888:
        mode.transfer := BGRA8888CopyP8
      else
        mode.transfer := AnyCopyP8
      end

    | d8:
      case src.code of
        a1, a8:
        mode.buf[0] := chr(Colors.Match(Colors.DisplayIndex, Colors.DisplayBits, val(int16, ord(mode.col[r])), val(int16, ord(mode.col[g])), val(int16, ord(mode.col[b]))))
        mode.transfer := ConstCopy8
      | p8:
        for i := 0 to src.pal.used - 1 do
          mode.map[i] := chr(Colors.Match(Colors.DisplayIndex, Colors.DisplayBits, val(int16, ord(src.pal.col[i][r])), val(int16, ord(src.pal.col[i][g])), val(int16, ord(src.pal.col[i][b]))))
        end

        mode.transfer := I8CopyI8
      | d8:
        mode.transfer := Copy8
      | bgr555, bgr565, bgr466:
        mode.transfer := Any16CopyD8
      | bgr888:
        mode.transfer := BGR888CopyD8
      | bgra8888:
        mode.transfer := BGRA8888CopyD8
      else
        mode.transfer := AnyCopyD8
      end

    | bgr555, bgr565, bgr466:
      case src.code of
        a1, a8:
        dst.pack(dst, cast(AnyPtr, @mode.buf[0]), 0, @mode.col)
        mode.transfer := ConstCopy16
      | p8:
        mode.transfer := P8CopyAny16
      | d8:
        mode.transfer := D8CopyAny16
      | bgr555, bgr565, bgr466:
        if src.code = dst.code then
          mode.transfer := Copy16
        else
          mode.transfer := Any16CopyAny16
        end

      | bgr888:
        mode.transfer := BGR888CopyAny16
      | bgra8888:
        mode.transfer := BGRA8888CopyAny16
      else
        mode.transfer := AnyCopyAny16
      end

    | bgr888:
      case src.code of
        a1, a8:
        copy(@mode.buf, @mode.col, 4)
        mode.transfer := ConstCopy24
      | p8:
        mode.transfer := P8CopyBGR888
      | d8:
        mode.transfer := D8CopyBGR888
      | bgr555, bgr565, bgr466:
        mode.transfer := Any16CopyBGR888
      | bgr888:
        mode.transfer := Copy24
      | bgra8888:
        mode.transfer := BGRA8888CopyBGR888
      else
        mode.transfer := AnyCopyBGR888
      end

    | bgra8888:
      case src.code of
        a1:
        mode.transfer := A1CopyBGRA8888
      | a8:
        mode.transfer := A8CopyBGRA8888
      | p8:
        mode.transfer := P8CopyBGRA8888
      | d8:
        mode.transfer := D8CopyBGRA8888
      | bgr555, bgr565, bgr466:
        mode.transfer := Any16CopyBGRA8888
      | bgr888:
        mode.transfer := BGR888CopyBGRA8888
      | bgra8888:
        mode.transfer := Copy32
      else
        mode.transfer := AnyCopyBGRA8888
      end

    else
      case src.code of
        a1:
        mode.transfer := A1CopyAny
      | p8:
        mode.transfer := P8CopyAny
      | d8:
        mode.transfer := D8CopyAny
      | bgr555, bgr565, bgr466:
        mode.transfer := Any16CopyAny
      | bgr888:
        mode.transfer := BGR888CopyAny
      | bgra8888:
        mode.transfer := BGRA8888CopyAny
      else
        if (band(src.bpp, 7) = 0) & (band(dst.bpp, 7) = 0) then
          mode.transfer := AnyBytesCopyAnyBytes
        else
          mode.transfer := AnyCopyAny
        end
      end
    end

  elsif op = dstOverSrc then
    mode.transfer := EmptyTransfer

  elsif op = srcOverDst then
    case dst.code of
      a1:
      case src.code of
        a1:
        mode.transfer := A1OverA1
      | a8:
        mode.transfer := A8OverA1
      | bgra8888:
        mode.transfer := BGRA8888OverA1
      else
        mode.transfer := AnyOverA1
      end

    | a8:
      case src.code of
        a1:
        mode.buf[0] := 0FFX
        mode.transfer := A1OverConst8
      | a8:
        mode.transfer := A8OverA8
      | bgra8888:
        mode.transfer := BGRA8888OverA8
      else
        mode.transfer := AnyOverA8
      end

    | bgra8888:
      case src.code of
        a1:
        copy(@mode.buf, @mode.col, 4)
        mode.transfer := A1OverConst32
      | a8:
        copy(@mode.buf, @mode.col, 4)
        mode.transfer := A8OverAny
      else
        mode.transfer := AnyOverBGRA8888
      end

    else
      case src.code of
        a1:
        case dst.code of
          p8:
          mode.buf[0] := chr(PaletteIndex(dst.pal, val(int16, ord(mode.col[r])), val(int16, ord(mode.col[g])), val(int16, ord(mode.col[b]))))
          mode.transfer := A1OverConst8
        | d8:
          mode.buf[0] := chr(Colors.Match(Colors.DisplayIndex, Colors.DisplayBits, val(int16, ord(mode.col[r])), val(int16, ord(mode.col[g])), val(int16, ord(mode.col[b]))))
          mode.transfer := A1OverConst8
        | bgr555, bgr565, bgr466:
          dst.pack(dst, cast(AnyPtr, @mode.buf[0]), 0, @mode.col)
          mode.transfer := A1OverConst16
        | bgr888:
          copy(@mode.buf, @mode.col, 4)
          mode.transfer := A1OverConst24
        else
          mode.transfer := A1OverAny
        end

      | a8:
        copy(@mode.buf, @mode.col, 4)
        mode.transfer := A8OverAny
      | bgra8888:
        mode.transfer := BGRA8888OverAny
      else
        mode.transfer := AnyBlendAny
      end
    end

  else
    mode.transfer := AnyBlendAny
  end

  assert(mode.transfer # nil)
end Bind

// --- Image Operations ---*

// get pixel from image *
procedure Get*(img: Image; x, y: int16; pix: pointer to array of char; mode: pointer to Mode)
  var
    bit: int32
    adr: AnyPtr
begin
  assert((0 <= x) & (x < img.width) & (0 <= y) & (y < img.height))
  bit := val(int32, x) * img.fmt.bpp
  adr := img.adr
  inc(adr, y * img.bpr)
  inc(adr, asr(bit, 3))
  bit := band(bit, 7)
  Bind(mode, @img.fmt, @PixelFormat)
  mode.transfer(mode, adr, bit, cast(AnyPtr, pix), 0, 1)
end Get

// put pixel into image *
procedure Put*(img: Image; x, y: int16; const pix: pointer to array of char; mode: pointer to Mode)
  var
    bit: int32
    adr: AnyPtr
begin
  assert((0 <= x) & (x < img.width) & (0 <= y) & (y < img.height))
  bit := val(int32, x) * img.fmt.bpp
  adr := img.adr
  inc(adr, y * img.bpr)
  inc(adr, asr(bit, 3))
  bit := band(bit, 7)
  Bind(mode, @PixelFormat, @img.fmt)
  mode.transfer(mode, cast(AnyPtr, @pix[0]), 0, adr, bit, 1)
end Put

// fill rectangular area *
procedure Fill*(img: Image; llx, lly, urx, ury: int16; const pix: pointer to array of char; mode: pointer to Mode)
  var
    bit: int32
    adr: AnyPtr
    bb: int32
    aa: AnyPtr
    m: Mode
    x: int16
begin
  assert((0 <= llx) & (llx < urx) & (urx <= img.width) & (0 <= lly) & (lly < ury) & (ury <= img.height))
  bit := val(int32, llx) * img.fmt.bpp
  adr := img.adr
  inc(adr, lly * img.bpr)
  inc(adr, asr(bit, 3))
  bit := band(bit, 7)
  Bind(mode, @PixelFormat, @img.fmt)
  if (mode.op in {clear,srcCopy}) or (pix[a] = 0FFX) & (mode.op in {srcOverDst,dstWithoutSrc}) then
    // dst is replaced
    // copy one pixel to lower left corner of rect
    mode.transfer(mode, cast(AnyPtr, @pix[0]), 0, adr, bit, 1)

    // copy pixel to rest of bottom row
    InitMode(@m, srcCopy)
    Bind(@m, @img.fmt, @img.fmt)
    if (bit = 0) & (band(img.fmt.bpp, 7) = 0) then
      // use simple address calculation
      bb := asr(img.fmt.bpp, 3)
      aa := adr
      inc(aa, bb)
      x := llx + 1
      while x < urx do
        m.transfer(@m, adr, 0, aa, 0, 1)
        inc(aa, bb)
        inc(x)
      end

    else
      bb := bit + img.fmt.bpp
      aa := adr
      inc(aa, asr(bb, 3))
      bb := band(bb, 7)
      x := llx + 1
      while x < urx do
        m.transfer(@m, adr, bit, aa, bb, 1)
        bb := bb + img.fmt.bpp
        inc(aa, asr(bb, 3))
        bb := band(bb, 7)
        inc(x)
      end
    end

    // now copy bottom row to others
    inc(lly)
    aa := adr
    inc(aa, img.bpr)
    while lly < ury do
      m.transfer(@m, adr, bit, aa, bit, urx - llx)
      inc(lly)
      inc(aa, img.bpr)
    end

  else
    // fill pixel by pixel
    while lly < ury do
      x := llx
      aa := adr
      bb := bit
      while x < urx do
        mode.transfer(mode, cast(AnyPtr, @pix[0]), 0, aa, bb, 1)
        bb := bb + img.fmt.bpp
        inc(aa, asr(bb, 3))
        bb := band(bb, 7)
        inc(x)
      end

      inc(lly)
      inc(adr, img.bpr)
    end
  end
end Fill

// clear image *
procedure Clear*(img: Image)
  var
    mode: Mode
begin
  InitMode(@mode, clear)
  Bind(@mode, @PixelFormat, @img.fmt)
  Fill(img, 0, 0, img.width, img.height, @Zero, @mode)
end Clear

// get several pixels and store them in array in requested format *
procedure GetPixels*(img: Image; x, y, w: int16; fmt: pointer to Format; buf: pointer to array of char; buf_len: int32; mode: pointer to Mode)
  var
    sbit: int32
    sadr: AnyPtr
begin
  assert((0 <= x) & (x + w <= img.width) & (0 <= y) & (y <= img.height))
  assert(asr(w * fmt.bpp, 3) <= val(int16, buf_len))
  Bind(mode, @img.fmt, fmt)
  sbit := val(int32, x) * img.fmt.bpp
  sadr := img.adr
  inc(sadr, y * img.bpr)
  inc(sadr, asr(sbit, 3))
  sbit := band(sbit, 7)
  mode.transfer(mode, sadr, sbit, cast(AnyPtr, @buf[0]), 0, w)
end GetPixels

// put several pixels from array in given format into image *
procedure PutPixels*(img: Image; x, y, w: int16; fmt: pointer to Format; buf: pointer to array of char; buf_len: int32; mode: pointer to Mode)
  var
    dbit: int32
    dadr: AnyPtr
begin
  assert((0 <= x) & (x + w <= img.width) & (0 <= y) & (y <= img.height))
  assert(asr(w * fmt.bpp, 3) <= val(int16, buf_len))
  dbit := val(int32, x) * img.fmt.bpp
  dadr := img.adr
  inc(dadr, y * img.bpr)
  inc(dadr, asr(dbit, 3))
  dbit := band(dbit, 7)
  Bind(mode, fmt, @img.fmt)
  mode.transfer(mode, cast(AnyPtr, @buf[0]), 0, dadr, dbit, w)
end PutPixels

// copy rectangular area to the same or another image in specified mode *
procedure Copy*(src, dst: Image; llx, lly, urx, ury, dx, dy: int16; mode: pointer to Mode)
  var
    w, h: int16
    sbit: int32
    sadr: AnyPtr
    dbit: int32
    dadr: AnyPtr
    slen: int32
    sa: AnyPtr
    sb: int32
    da: AnyPtr
    db, len_, l: int32
begin
  assert((0 <= llx) & (llx <= urx) & (urx <= src.width) & (0 <= lly) & (lly <= ury) & (ury <= src.height))
  assert((0 <= dx) & (dx + urx - llx <= dst.width) & (0 <= dy) & (dy + ury - lly <= dst.height))
  Bind(mode, @src.fmt, @dst.fmt)
  w := urx - llx
  h := ury - lly
  if (src # dst) or (lly > dy) or (lly = dy) & ((llx > dx) or (urx <= dx)) then
    // copy lines bottom-up
    sbit := val(int32, llx) * src.fmt.bpp
    sadr := src.adr
    inc(sadr, lly * src.bpr)
    inc(sadr, asr(sbit, 3))
    sbit := band(sbit, 7)
    dbit := val(int32, dx) * dst.fmt.bpp
    dadr := dst.adr
    inc(dadr, dy * dst.bpr)
    inc(dadr, asr(dbit, 3))
    dbit := band(dbit, 7)
    while h > 0 do
      mode.transfer(mode, sadr, sbit, dadr, dbit, w)
      inc(sadr, src.bpr)
      inc(dadr, dst.bpr)
      dec(h)
    end

  elsif lly < dy then
    // copy lines top-down
    sbit := val(int32, llx) * src.fmt.bpp
    sadr := src.adr
    inc(sadr, ury * src.bpr)
    inc(sadr, asr(sbit, 3))
    sbit := band(sbit, 7)
    dbit := val(int32, dx) * dst.fmt.bpp
    dadr := dst.adr
    inc(dadr, (dy + h) * dst.bpr)
    inc(dadr, asr(dbit, 3))
    dbit := band(dbit, 7)
    while h > 0 do
      dec(sadr, src.bpr)
      dec(dadr, dst.bpr)
      dec(h)
      mode.transfer(mode, sadr, sbit, dadr, dbit, w)
    end

  elsif llx # dx then
    // uh oh! overlapping spans
    slen := dx + w - urx // maximal span length guaranteeing non-overlapping spans
    sbit := val(int32, urx) * src.fmt.bpp
    sadr := src.adr
    inc(sadr, lly * src.bpr)
    inc(sadr, asr(sbit, 3))
    sbit := band(sbit, 7)
    dbit := val(int32, dx + w) * dst.fmt.bpp
    dadr := dst.adr
    inc(dadr, dy * dst.bpr)
    inc(dadr, asr(dbit, 3))
    dbit := band(dbit, 7)
    while h > 0 do
      sa := sadr
      sb := sbit
      da := dadr
      db := dbit
      len_ := w
      while len_ > 0 do
        l := slen
        if l > len_ then
          l := len_
        end
        dec(sb, l * src.fmt.bpp)
        inc(sa, asr(sb, 3))
        sb := band(sb, 7)
        dec(db, l * dst.fmt.bpp)
        inc(da, asr(db, 3))
        db := band(db, 7)
        mode.transfer(mode, sa, sb, da, db, l)
        dec(len_, l)
      end

      inc(sadr, src.bpr)
      inc(dadr, dst.bpr)
      dec(h)
    end
  end
end Copy

// replicate pattern within rectangular area of image using given mode *
procedure FillPattern*(pat, dst: Image; llx, lly, urx, ury, px, py: int16; mode: pointer to Mode)
  var
    pw, ph, olx, oby, ilx, olw, irw, dy, sy, dx, sx, ty: int16
begin
  assert((0 <= llx) & (llx <= urx) & (urx <= dst.width) & (0 <= lly) & (lly <= ury) & (ury <= dst.height))
  pw := pat.width
  ph := pat.height
  olx := px + obdiv(llx - px, pw) * pw
  oby := py + obdiv(lly - py, ph) * ph
  ilx := olx + pw
  olw := llx - olx
  irw := obmod(urx - px, pw)
  if urx - irw < ilx then
    irw := olw + urx - llx
  end
  dy := lly
  sy := lly - oby
  if (oby < lly) & (oby + ph <= ury) then
    dx := llx
    sx := olw
    if (olx < llx) & (ilx <= urx) then
      Copy(pat, dst, sx, sy, pw, ph, llx, lly, mode)
      dx := ilx
      sx := 0
    end

    while dx + pw <= urx do
      Copy(pat, dst, 0, sy, pw, ph, dx, lly, mode)
      inc(dx, pw)
    end

    if dx < urx then
      Copy(pat, dst, sx, sy, irw, ph, dx, lly, mode)
    end

    dy := oby + ph
    sy := 0
  end

  while dy + ph <= ury do
    dx := llx
    sx := olw
    if (olx < llx) & (ilx <= urx) then
      Copy(pat, dst, sx, 0, pw, ph, llx, dy, mode)
      dx := ilx
      sx := 0
    end

    while dx + pw <= urx do
      Copy(pat, dst, 0, 0, pw, ph, dx, dy, mode)
      inc(dx, pw)
    end

    if dx < urx then
      Copy(pat, dst, sx, 0, irw, ph, dx, dy, mode)
    end

    inc(dy, ph)
  end

  if dy < ury then
    ty := sy + ury - dy
    dx := llx
    sx := olw
    if (olx < llx) & (ilx <= urx) then
      Copy(pat, dst, sx, sy, pw, ty, llx, dy, mode)
      dx := ilx
      sx := 0
    end

    while dx + pw <= urx do
      Copy(pat, dst, 0, sy, pw, ty, dx, dy, mode)
      inc(dx, pw)
    end

    if dx < urx then
      Copy(pat, dst, sx, sy, irw, ty, dx, dy, mode)
    end
  end
end FillPattern

// darken image while maintaining coverage *
procedure Darken*(img: Image; factor: real)
  var
    s, i, j, k: int32
    adr: AnyPtr
    bit: int32
    clamp: array 256 of char
    y, x: int16
    pix: Pixel
begin
  s := val(int32, abs(floor(val(real, 255) * factor + 0.5)))
  if (s # 255) & (img.fmt.components # {alpha}) then
    i := 256
    j := 256 * s
    repeat
      dec(i)
      dec(j, s)
      k := obdiv(j, 255)
      if k <= 255 then
        clamp[i] := chr(k)
      else
        clamp[i] := 0FFX
      end
    until i = 0

    y := 0
    while y < img.height do
      x := 0
      adr := img.adr
      inc(adr, y * img.bpr)
      bit := 0
      while x < img.width do
        img.fmt.unpack(@img.fmt, adr, bit, @pix)
        pix[r] := clamp[ord(pix[r])]
        pix[g] := clamp[ord(pix[g])]
        pix[b] := clamp[ord(pix[b])]
        img.fmt.pack(@img.fmt, adr, bit, @pix)
        bit := bit + img.fmt.bpp
        inc(adr, bit)
        bit := band(bit, 7)
        inc(x)
      end

      inc(y)
    end
  end
end Darken

// fade image *
procedure Fade*(img: Image; factor: real)
  var
    s, i, j, k: int32
    adr: AnyPtr
    bit: int32
    clamp: array 256 of char
    y, x: int16
    pix: Pixel
begin
  s := val(int32, abs(floor(val(real, 255) * factor + 0.5)))
  if s = 0 then
    Clear(img)
  elsif s # 255 then
    i := 256
    j := 256 * s
    repeat
      dec(i)
      dec(j, s)
      k := obdiv(j, 255)
      if k <= 255 then
        clamp[i] := chr(k)
      else
        clamp[i] := 0FFX
      end
    until i = 0

    y := 0
    while y < img.height do
      x := 0
      adr := img.adr
      inc(adr, y * img.bpr)
      bit := 0
      while x < img.width do
        img.fmt.unpack(@img.fmt, adr, bit, @pix)
        pix[r] := clamp[ord(pix[r])]
        pix[g] := clamp[ord(pix[g])]
        pix[b] := clamp[ord(pix[b])]
        pix[a] := clamp[ord(pix[a])]
        img.fmt.pack(@img.fmt, adr, bit, @pix)
        bit := bit + img.fmt.bpp
        inc(adr, bit)
        bit := band(bit, 7)
        inc(x)
      end

      inc(y)
    end
  end
end Fade

// make image brighter and more transparent; Opaque(I, f) = Darken(Fade(I, f), 1/f) *
procedure Opaque*(img: Image; factor: real)
  var
    s, i, j, k: int32
    adr: AnyPtr
    bit: int32
    clamp: array 256 of char
    y, x: int16
    pix: Pixel
begin
  s := val(int32, abs(floor(val(real, 255) * factor + 0.5)))
  if s = 0 then
    Clear(img)
  elsif s # 255 then
    i := 256
    j := 256 * s
    repeat
      dec(i)
      dec(j, s)
      k := obdiv(j, 255)
      if k <= 255 then
        clamp[i] := chr(k)
      else
        clamp[i] := 0FFX
      end
    until i = 0

    y := 0
    while y < img.height do
      x := 0
      adr := img.adr
      inc(adr, y * img.bpr)
      bit := 0
      while x < img.width do
        img.fmt.unpack(@img.fmt, adr, bit, @pix)
        pix[a] := clamp[ord(pix[a])]
        img.fmt.pack(@img.fmt, adr, bit, @pix)
        bit := bit + img.fmt.bpp
        inc(adr, bit)
        bit := band(bit, 7)
        inc(x)
      end

      inc(y)
    end
  end
end Opaque

// add components of two (faded) images *
procedure Add*(i, j, res: Image)
  var
    y, x: int16
    iadr: AnyPtr
    ibit: int32
    jadr: AnyPtr
    jbit: int32
    radr: AnyPtr
    rbit, k: int32
    ipix, jpix, rpix: Pixel
begin
  assert((i.width = j.width) & (i.height = j.height) & (i.width <= res.width) & (i.height <= res.height))
  y := 0
  while y < i.height do
    x := 0
    iadr := i.adr
    inc(iadr, y * i.bpr)
    ibit := 0
    jadr := j.adr
    inc(jadr, y * j.bpr)
    jbit := 0
    radr := res.adr
    inc(radr, y * res.bpr)
    rbit := 0
    while x < i.width do
      i.fmt.unpack(@i.fmt, iadr, ibit, @ipix)
      j.fmt.unpack(@j.fmt, jadr, jbit, @jpix)
      for k := 0 to 3 do
        rpix[k] := Clamp[val(int16, ord(ipix[k])) + val(int16, ord(jpix[k]))]
      end

      res.fmt.pack(@res.fmt, radr, rbit, @rpix)
      ibit := ibit + i.fmt.bpp
      inc(iadr, ibit)
      ibit := band(ibit, 7)
      jbit := jbit + j.fmt.bpp
      inc(jadr, jbit)
      jbit := band(jbit, 7)
      rbit := rbit + res.fmt.bpp
      inc(radr, rbit)
      rbit := band(rbit, 7)
      inc(x)
    end

    inc(y)
  end
end Add

// copy image to another using error diffusion dithering (Floyd-Steinberg) *
procedure Dither*(src, dst: Image)

  type
    error = record
      r, g, b: int16
    end

  var
    e351: pointer to array of error
    y, x, ex, e, e3, e5: int16
    sadr, dadr, sa: AnyPtr
    sb: int32
    da: AnyPtr
    db: int32
    e7, e51, e1: error
    spix, dpix: Pixel
begin
  assert((src.width <= dst.width) & (src.height <= dst.height))
  newgc(e351, src.width + 2) // accumulated error for next row
  y := 0
  sadr := src.adr
  dadr := dst.adr
  while y < src.height do
    // scan from left to right
    e7.r := 0
    e7.g := 0
    e7.b := 0
    e51.r := 0
    e51.g := 0
    e51.b := 0
    e1.r := 0
    e1.g := 0
    e1.b := 0
    x := 0
    sa := sadr
    sb := 0
    da := dadr
    db := 0
    while x < src.width do
      ex := x + 1
      src.fmt.unpack(@src.fmt, sa, sb, @spix)
      spix[r] := Clamp[512 + val(int16, ord(spix[r])) + e351[ex].r + e7.r]
      spix[g] := Clamp[512 + val(int16, ord(spix[g])) + e351[ex].g + e7.g]
      spix[b] := Clamp[512 + val(int16, ord(spix[b])) + e351[ex].b + e7.b]
      dst.fmt.pack(@dst.fmt, da, db, @spix)
      dst.fmt.unpack(@dst.fmt, da, db, @dpix)
      e := val(int16, ord(spix[r])) - val(int16, ord(dpix[r]))
      e3 := asr(3 * e, 4)
      e5 := asr(5 * e, 4)
      e7.r := asr(7 * e, 4)
      e351[x].r := e3 + e51.r
      e51.r := e5 + e1.r
      e1.r := e - e3 - e5 - e7.r
      e := val(int16, ord(spix[g])) - val(int16, ord(dpix[g]))
      e3 := asr(3 * e, 4)
      e5 := asr(5 * e, 4)
      e7.g := asr(7 * e, 4)
      e351[x].g := e3 + e51.g
      e51.g := e5 + e1.g
      e1.g := e - e3 - e5 - e7.g
      e := val(int16, ord(spix[b])) - val(int16, ord(dpix[b]))
      e3 := asr(3 * e, 4)
      e5 := asr(5 * e, 4)
      e7.b := asr(7 * e, 4)
      e351[x].b := e3 + e51.b
      e51.b := e5 + e1.b
      e1.b := e - e3 - e5 - e7.b
      sb := sb + src.fmt.bpp
      inc(sa, asr(sb, 3))
      sb := band(sb, 7)
      db := db + dst.fmt.bpp
      inc(da, asr(db, 3))
      db := band(db, 7)
      x := ex
    end

    inc(y)
    inc(sadr, src.bpr)
    inc(dadr, dst.bpr)
    if y < src.height then
      // scan from right to left
      e351[x] := e51
      e7.r := 0
      e7.g := 0
      e7.b := 0
      e51.r := 0
      e51.g := 0
      e51.b := 0
      e1.r := 0
      e1.g := 0
      e1.b := 0
      inc(sa, src.bpr)
      inc(da, dst.bpr)
      while x > 0 do
        ex := x
        dec(x)
        sb := sb - src.fmt.bpp
        inc(sa, asr(sb, 3))
        sb := band(sb, 7)
        db := db - dst.fmt.bpp
        inc(da, asr(db, 3))
        db := band(db, 7)
        src.fmt.unpack(@src.fmt, sa, sb, @spix)
        spix[r] := Clamp[512 + val(int16, ord(spix[r])) + e351[ex].r + e7.r]
        spix[g] := Clamp[512 + val(int16, ord(spix[g])) + e351[ex].g + e7.g]
        spix[b] := Clamp[512 + val(int16, ord(spix[b])) + e351[ex].b + e7.b]
        dst.fmt.pack(@dst.fmt, da, db, @spix)
        dst.fmt.unpack(@dst.fmt, da, db, @dpix)
        inc(ex)
        e := val(int16, ord(spix[r])) - val(int16, ord(dpix[r]))
        e3 := asr(3 * e, 4)
        e5 := asr(5 * e, 4)
        e7.r := asr(7 * e, 4)
        e351[x].r := e3 + e51.r
        e51.r := e5 + e1.r
        e1.r := e - e3 - e5 - e7.r
        e := val(int16, ord(spix[g])) - val(int16, ord(dpix[g]))
        e3 := asr(3 * e, 4)
        e5 := asr(5 * e, 4)
        e7.g := asr(7 * e, 4)
        e351[x].g := e3 + e51.g
        e51.g := e5 + e1.g
        e1.g := e - e3 - e5 - e7.g
        e := val(int16, ord(spix[b])) - val(int16, ord(dpix[b]))
        e3 := asr(3 * e, 4)
        e5 := asr(5 * e, 4)
        e7.b := asr(7 * e, 4)
        e351[x].b := e3 + e51.b
        e51.b := e5 + e1.b
        e1.b := e - e3 - e5 - e7.b
      end

      e351[1] := e51
      inc(y)
      inc(sadr, src.bpr)
      inc(dadr, dst.bpr)
    end
  end
end Dither

// --- Image Objects ---*

// write image to file rider *
procedure Write*(fr: pointer to Files.Rider; img: Image)
  var
    m: Image
    h: int32
    adr: AnyPtr
    w: int32
    aa: AnyPtr
    len_: int32
    buf: array 256 of char
begin
  if ~(img.fmt.code in {a1..bgra8888}) then
    newgc(m)
    if img.fmt.components = {color} then
      Create(m, img.width, img.height, @BGR888)
    elsif img.fmt.components = {alpha} then
      Create(m, img.width, img.height, @A8)
    elsif img.fmt.components = {index} then
      Create(m, img.width, img.height, @D8)
    else
      Create(m, img.width, img.height, @BGRA8888)
    end

    Copy(img, m, 0, 0, img.width, img.height, 0, 0, @SrcCopy)
    img := m
  end

  Files.WriteNum(fr, 1) // version
  Files.WriteNum(fr, img.fmt.code)
  Files.WriteNum(fr, img.width)
  Files.WriteNum(fr, img.height)
  Files.WriteNum(fr, abs(img.bpr))
  h := img.height
  adr := img.adr
  while h > 0 do
    w := abs(img.bpr)
    aa := adr
    while w > 0 do
      len_ := 256
      if len_ > w then
        len_ := w
      end
      SYS.MOVE(aa, cast(AnyPtr, @buf[0]), len_)
      Files.WriteBytes(fr, cast(BytesPtr, @buf), 256, len_)
      dec(w, len_)
      inc(aa, len_)
    end

    dec(h)
    inc(adr, img.bpr)
  end

  if img.fmt.code = p8 then
    Files.WriteInt(fr, img.fmt.pal.used)
    len_ := 0
    while len_ < img.fmt.pal.used do
      Files.Write(fr, val(byte, ord(img.fmt.pal.col[len_][r])))
      Files.Write(fr, val(byte, ord(img.fmt.pal.col[len_][g])))
      Files.Write(fr, val(byte, ord(img.fmt.pal.col[len_][b])))
      inc(len_)
    end
  end
end Write

// read image from file rider *
procedure Read*(fr: pointer to Files.Rider; img: Image)
  var
    ver, code, w, h, bpr: int32
    adr, aa: AnyPtr
    len_: int32
    fmt: Format
    buf: array 256 of char
    used: int16
begin
  Files.ReadNum(fr, @ver) // only know version 1, skip check
  Files.ReadNum(fr, @code)
  case code of
    1 (* a1 *):
    fmt := A1
  | 2 (* a8 *):
    fmt := A8
  | 4 (* p8 *):
    InitFormat(@fmt, p8, 8, 1, {index}, nil, PackP8, UnpackP8)
  | 3 (* d8 *):
    fmt := D8
  | 5 (* bgr555 *):
    fmt := BGR555
  | 6 (* bgr565 *):
    fmt := BGR565
  | 7 (* bgr466 *):
    fmt := BGR466
  | 8 (* bgr888 *):
    fmt := BGR888
  | 9 (* bgra8888 *):
    fmt := BGRA8888
  end

  Files.ReadNum(fr, @w)
  Files.ReadNum(fr, @h)
  Create(img, val(int16, w), val(int16, h), @fmt)
  Files.ReadNum(fr, @bpr)
  assert(bpr <= img.bpr)
  adr := img.adr
  while h > 0 do
    w := bpr
    aa := adr
    while w > 0 do
      len_ := 256
      if len_ > w then
        len_ := w
      end
      Files.ReadBytes(fr, cast(BytesPtr, @buf), 256, len_)
      SYS.MOVE(cast(AnyPtr, @buf[0]), aa, len_)
      dec(w, len_)
      inc(aa, len_)
    end

    dec(h)
    inc(adr, img.bpr)
  end

  if code = p8 then
    Files.ReadInt(fr, @used)
    len_ := 0
    newgc(img.fmt.pal)
    while len_ < used do
      Files.Read(fr, cast(BytePtr, @img.fmt.pal.col[len_][r]))
      Files.Read(fr, cast(BytePtr, @img.fmt.pal.col[len_][g]))
      Files.Read(fr, cast(BytePtr, @img.fmt.pal.col[len_][b]))
      img.fmt.pal.col[len_][a] := 0FFX
      inc(len_)
    end

    InitPalette(img.fmt.pal, used, 4)
  end
end Read

// image handler *
procedure Handle*(obj: Objects.Object; msg: pointer to Objects.ObjMsg)
  var
    img, copy_: Image
    lib: Objects.Library
    ref: int16
begin
  img := obj(Image)
  case msg of
  | Objects.PAttrMsg:
    if msg.id = Objects.enum then
      msg.Enum("Width")
      msg.Enum("Height")
    elsif msg.id = Objects.get then
      if msg.name = "Gen" then
        msg.class := Objects.String
        copy(@msg.s, "Images.New", 64)
        msg.res := 0
      elsif msg.name = "Width" then
        msg.class := Objects.Int
        msg.i := img.width
        msg.res := 0
      elsif msg.name = "Height" then
        msg.class := Objects.Int
        msg.i := img.height
        msg.res := 0
      end
    end

  | Objects.PCopyMsg:
    if msg.stamp # img.stamp then
      newgc(copy_)
      img.dlink := copy_
      img.stamp := msg.stamp
      Create(copy_, img.width, img.height, @img.fmt)
      if img.fmt.pal # nil then
        newgc(copy_.fmt.pal)
        copy_.fmt.pal.col := img.fmt.pal.col
        InitPalette(copy_.fmt.pal, img.fmt.pal.used, img.fmt.pal.bits_)
        Copy(img, copy_, 0, 0, img.width, img.height, 0, 0, @SrcCopy)
      end
    end

    msg.obj := img.dlink

  | Objects.PBindMsg:
    lib := msg(Objects.PBindMsg).lib
    if lib # nil then
      if (img.lib = nil) or (img.lib.name[0] = 0X) & (img.lib # lib) then
        lib.GenRef(lib, @ref)
        if ref >= 0 then
          lib.PutObj(lib, ref, img)
        end
      end
    end

  | Objects.PFileMsg:
    if msg.id = Objects.store then
      Write(@msg.R, img)
    elsif msg.id = Objects.load then
      Read(@msg.R, img)
    end

  end
end Handle

// image generator *
procedure New*()
  var
    img: Image
begin
  newgc(img)
  img.handle := Handle
  Objects.NewObj := img
end New

// update part of an image *
procedure Update*(img: Image; llx, lly, urx, ury: int16)
  var
    um: UpdateMsg
begin
  um.F := nil
  um.img := img
  um.llx := llx
  um.lly := lly
  um.urx := urx
  um.ury := ury
  Display.Broadcast(@um)
end Update

// --- Initialization ---

procedure InitBitTables()
  var
    b, i: int32
begin
  for b := 0 to 255i2 do
    for i := 0 to 7 do
      if ((asr(b, usig(7 - i)) mod 2) # 0) then
        Bit[b][i] := true
        Set[b][i] := chr(b)
        Clr[b][i] := chr(b - sigc(shl(val(int32, 1), usig(7 - i))))
      else
        Bit[b][i] := false
        Set[b][i] := chr(b + sigc(shl(val(int32, 1), usig(7 - i))))
        Clr[b][i] := chr(b)
      end
    end
  end
end InitBitTables

procedure InitClamp()
  var
    i: int32
begin
  for i := 0 to 511 do
    Clamp[i] := 0X
  end
  for i := 0 to 255i2 do
    Clamp[512 + i] := chr(i)
  end
  for i := 768 to 1279 do
    Clamp[i] := 0FFX
  end
end InitClamp

type CMD_ = procedure()

procedure cmd_*(i: int32; name: ^array 32 of char): CMD_
begin
  if i = 0 then if name # nil then name^ := "New" end return New end
  return nil
end cmd_

begin
  Modules.Register("Images", cmd_)
  Out.String("Images 1.03/eos 22.06.2000")
  Out.Ln()
  InitFormat(@A1, a1, 1, 1, {alpha}, nil, PackA1, UnpackA1)
  InitFormat(@A8, a8, 8, 1, {alpha}, nil, PackA8, UnpackA8)
  InitFormat(@D8, d8, 8, 1, {index}, nil, PackD8, UnpackD8)
  InitFormat(@BGR555, bgr555, 16, 2, {color}, nil, PackBGR555, UnpackBGR555)
  InitFormat(@BGR565, bgr565, 16, 2, {color}, nil, PackBGR565, UnpackBGR565)
  InitFormat(@BGR466, bgr466, 16, 2, {color}, nil, PackBGR466, UnpackBGR466)
  InitFormat(@BGR888, bgr888, 24, 4, {color}, nil, PackBGR888, UnpackBGR888)
  InitFormat(@BGRA8888, bgra8888, 32, 4, {color,alpha}, nil, PackBGRA8888, UnpackBGRA8888)
  PixelFormat := BGRA8888
  case Display.TransferFormat(Display.ColLeft) of
    16 (* Display.color555 *):
    DisplayFormat := BGR555
  | 17 (* Display.color565 *):
    DisplayFormat := BGR565
  | 18 (* Display.color664 *):
    DisplayFormat := BGR466
  | 24 (* Display.color888 *):
    DisplayFormat := BGR888
  | 32 (* Display.color8888 *):
    DisplayFormat := BGRA8888
  else
    DisplayFormat := D8
  end

  InitMode(@SrcCopy, srcCopy)
  InitMode(@SrcOverDst, srcOverDst)
  InitBitTables()
  InitClamp()
  Zero[0] := 0X
  Zero[1] := 0X
  Zero[2] := 0X
  Zero[3] := 0X
end Images.
