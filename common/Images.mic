procedure D8CopyAny(mode: pointer to Mode0; sadr: AnyPtr; sbit: int32; dadr: AnyPtr; dbit, len_: int32)
  var
    pix: Pixel
    byte_: char
begin
  pix[a] := 0FFX
  while len_ > 0 do
    byte_ := cast(CharPtr, sadr)^
    pix[r] := chr(Colors.Red[ord(byte_)])
    pix[g] := chr(Colors.Green[ord(byte_)])
    pix[b] := chr(Colors.Blue[ord(byte_)])
    mode.dst.pack(@mode.dst, dadr, dbit, @pix)
    inc(sadr)
    dbit := dbit + mode.dst.bpp
    inc(dadr, asr(dbit, 3))
    dbit := band(dbit, 7)
    dec(len_)
  end
end D8CopyAny

