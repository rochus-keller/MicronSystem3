module Reals [level=5]

import Kernel, Modules
// portable (with exceptions)

(** Implementation of the non-portable components of IEEE REAL and
LONGREAL manipulation. The routines here are required to do conversion
of reals to strings and back.
Implemented by Bernd Moesli, Seminar for Applied Mathematics,
Swiss Federal Institute of Technology Zurich.
*)

(* Bernd Moesli
Seminar for Applied Mathematics
Swiss Federal Institute of Technology Zurich
Copyright 1993

Support module for IEEE floating-point numbers

Please change constant definitions of H, L depending on byte ordering
Use bm.TestReals.Do for testing the implementation.

Expo, ExpoL return the shifted binary exponent (0 <= e < 256 (2048 resp.))
SetExpo, SetExpoL set the shifted binary exponent
Real, RealL convert hexadecimals to reals
Int, IntL convert reals to hexadecimals
Ten returns 10^e (e <= 308, 308 < e delivers NaN)

2026 me@rochus-keller.ch VFX/ARM32 migration
1993.4.22 IEEE format only, 32-bits LONGINTs only
30.8.1993 mh: changed RealX to avoid compiler warnings;
7.11.1995 jt: dynamic endianess test
22.01.97 pjm: NaN stuff (using quiet NaNs only to avoid traps)
05.01.98 prk: NaN with INF support
*)

type 
  AnyPtr = pointer to byte // helper type for Oberon addresses and SYSTEM.PTR
  BooleanPtr = pointer to boolean // helper type for a variable reinterpreted by SYSTEM.VAL
  Int32Ptr = pointer to int32 // helper type for a variable reinterpreted by SYSTEM.VAL
  RealPtr = pointer to real // helper type for a variable reinterpreted by SYSTEM.VAL

var
  DefaultFCR*: set
  tene: array 23 of longreal // e = 0..22: exact values of 10^e
  ten: array 27 of longreal
  eq, gr: array 20 of set
  H, L: int16

// Returns the shifted binary exponent (0 <= e < 256).
procedure Expo*(x: real): int32
begin
  return band(asr(cast(int32, x), 23), 255)
end Expo

// Returns the shifted binary exponent (0 <= e < 2048).
procedure ExpoL*(x: longreal): int32
  var
    i: int32
begin
  i := cast(Int32Ptr, ptroff(@x, H))^
  return band(asr(i, 20), 2047)
end ExpoL

// Sets the shifted binary exponent.
procedure SetExpo*(e: int32; x: pointer to real)
  var
    i: int32
begin
  i := cast(Int32Ptr, x)^
  i := sigc(shl(val(int32, sigc(shl(val(int32, asr(i, 31)), 8)) + band(e, 255)), 23)) + band(i, 8388607)
  cast(Int32Ptr, x)^ := i
end SetExpo

// Sets the shifted binary exponent.
procedure SetExpoL*(e: int32; x: pointer to longreal)
  var
    i: int32
begin
  i := cast(Int32Ptr, ptroff(x, H))^
  i := sigc(shl(val(int32, sigc(shl(val(int32, asr(i, 31)), 11)) + band(e, 2047)), 20)) + band(i, 1048575)
  cast(Int32Ptr, ptroff(x, H))^ := i
end SetExpoL

// Convert hexadecimal to REAL.
procedure Real*(h: int32): real
  var
    x: real
begin
  cast(Int32Ptr, @x)^ := h
  return x
end Real

// Convert hexadecimal to LONGREAL. h and l are the high and low parts.
procedure RealL*(h, l: int32): longreal
  var
    x: longreal
begin
  cast(Int32Ptr, ptroff(@x, H))^ := h
  cast(Int32Ptr, ptroff(@x, L))^ := l
  return x
end RealL

// Convert REAL to hexadecimal.
procedure Int*(x: real): int32
  var
    i: int32
begin
  cast(RealPtr, @i)^ := x
  return i
end Int

// Convert LONGREAL to hexadecimal. h and l are the high and low parts.
procedure IntL*(x: longreal; h, l: pointer to int32)
begin
  h^ := cast(Int32Ptr, ptroff(@x, H))^
  l^ := cast(Int32Ptr, ptroff(@x, L))^
end IntL

// Returns 10^e (e <= 308, 308 < e delivers IEEE-code +INF).
procedure Ten*(e: int32): longreal
  var
    E: int32
    r: longreal
begin
  if e < -307 then
    return val(longreal, 0)
  elsif 308 < e then
    return RealL(2146435072, 0)
  end
  inc(e, 307)
  r := ten[obdiv(e, 23)] * tene[obmod(e, 23)]
  if band(e, 31) in eq[asr(e, 5)] then
    return r
  else
    E := ExpoL(r)
    SetExpoL(1023i2 + 52i2, @r)
    if band(e, 31) in gr[asr(e, 5)] then
      r := r - val(longreal, 1)
    else
      r := r + val(longreal, 1)
    end
    SetExpoL(E, @r)
    return r
  end
  return 0.0 // TODO o2m: Micron requires a result on all control paths
end Ten

// Returns the NaN code (0 <= c < 8399608) or -1 if not NaN/Infinite.
procedure NaNCode*(x: real): int32
begin
  if band(asr(cast(int32, x), 23), 255) = 255 then
    // Infinite or NaN
    return band(cast(int32, x), 8388607) // lowest 23 bits
  else
    return -1
  end
  return 0 // TODO o2m: Micron requires a result on all control paths
end NaNCode

// Returns the NaN code (0 <= h < 1048576, MIN(LONGINT) <= l <= MAX(LONGINT)) or (-1,-1) if not NaN/Infinite.
procedure NaNCodeL*(x: longreal; h, l: pointer to int32)
begin
  h^ := cast(Int32Ptr, ptroff(@x, H))^
  l^ := cast(Int32Ptr, ptroff(@x, L))^
  if band(asr(h^, 20), 2047) = 2047 then
    // Infinite or NaN
    h^ := band(h^, 1048575) // lowest 20 bits
  else
    h^ := -1
    l^ := -1
  end
end NaNCodeL

// Returns TRUE iff x is NaN/Infinite.
procedure IsNaN*(x: real): boolean
begin
  return band(asr(cast(int32, x), 23), 255) = 255
end IsNaN

// Returns TRUE iff x is NaN/Infinite.
procedure IsNaNL*(x: longreal): boolean
  var
    h: int32
begin
  h := cast(Int32Ptr, ptroff(@x, H))^
  return band(asr(h, 20), 2047) = 2047
end IsNaNL

// Returns NaN with specified code (0 <= l < 8399608).
procedure NaN*(l: int32): real
  var
    x: real
begin
  cast(Int32Ptr, @x)^ := band(l, 8388607) + 2139095040
  return x
end NaN

// Returns NaN with specified code (0 <= h < 1048576, MIN(LONGINT) <= l <= MAX(LONGINT)).
procedure NaNL*(h, l: int32): longreal
  var
    x: longreal
begin
  h := band(h, 1048575) + 2146435072
  cast(Int32Ptr, ptroff(@x, H))^ := h
  cast(Int32Ptr, ptroff(@x, L))^ := l
  return x
end NaNL

procedure fcr(): set
begin
  // TODO o2m: the following inline assembler needs manual translation
  // CODE {SYSTEM.arm}
  // DCW 0A10H, 0EEF1H (* VMRS R0, FPSCR *)
  //
  return {} // TODO o2m: the result is delivered by the assembler code above
end fcr

// Return state of the floating-point control register.
procedure FCR*(): set
begin
  if Kernel.copro then
    return fcr()
  else
    return DefaultFCR
  end
  return {} // TODO o2m: Micron requires a result on all control paths
end FCR

procedure setfcr(s: set)
begin
  // TODO o2m: the following inline assembler needs manual translation
  // CODE {SYSTEM.arm}
  // DCW 0008H, 0E59BH (* LDR R0, [R11, #8] ; load param s *)
  // DCW 0A10H, 0EEE1H (* VMSR FPSCR, R0 *)
  //
end setfcr

// Set state of floating-point control register.  Traps reset this to the default & ENTIER resets the rounding mode.
procedure SetFCR*(s: set)
begin
  if Kernel.copro then
    setfcr(s)
  end
end SetFCR

procedure RealX(h, l: int32; adr: AnyPtr)
begin
  cast(Int32Ptr, ptroff(adr, H))^ := h
  cast(Int32Ptr, ptroff(adr, L))^ := l
end RealX

procedure InitHL()
  var
    i: AnyPtr
    dmy: int16
    littleEndian: boolean
begin
  (* VFP hardware enable (CPACR+FPEXC) and FPSCR configuration are done by
  the Kernel module body.  Here we only read back the current FPSCR as
  DefaultFCR so that SetFCR callers have the correct baseline. *)
  DefaultFCR := FCR()

  dmy := 1
  i := cast(AnyPtr, @dmy)
  littleEndian := cast(BooleanPtr, i)^ // indirection via i avoids warning on SUN cc -O
  if littleEndian then
    H := 4
    L := 0
  else
    H := 0
    L := 4
  end
end InitHL

