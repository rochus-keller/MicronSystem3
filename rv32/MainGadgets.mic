module Main [level=5] // the boot file of the Micron Oberon System 3

import 
  Heaps, Kernel, Modules, Disks, SDDisks, OFS, OFSDiskVolumes, OFSAosFiles, OFSCacheVolumes, OFSBoot, 
  Boot, Files, __mic, Displays, Objects, DisplayLinear, Display, Input, Viewers, Fonts, Reals, Texts, 
  Oberon, MenuViewers, TextFrames, System, VMInput, CLUTs, Dates, Strings, Bitmaps, Out, Pictures, Display3, 
  Effects, Centronics, V24, Printer, Printer3, Attributes, Links, Gadgets, Math, Rembrandt0, Rembrandt, BasicGadgets, 
  Clocks, Colors, Images, ColorGadgets, ColorModels, Views, ColorTools, ColorWells, Documents, Desktops, FileDir, 
  Icons, ListRiders, ListGadgets, ListModels, Lists, TextGadgets0, NamePlates, Panels, Organizers, Outlines, PanelDocs, 
  RefGadgets, Styles, ScriptFrames, Script, Scrollbars, ScrollViews, TextGadgets, TextDocs, TextFields, TimeStamps 
  
